---
import BaseLayout from '../layouts/BaseLayout.astro';
import fs from 'node:fs';
import path from 'node:path';

// Общий CSS сайта (шапка/футер/контейнер/кнопки) живёт в инлайн-блобе meta.json
// catch-all страниц. У 404 (отдельная Astro-страница) его нет — без него шапка
// распадается и SVG-иконки раздуваются. Подтягиваем блоб главной.
let baseStyles = '';
try {
  const meta = JSON.parse(fs.readFileSync(path.resolve('./src/raw-pages/meta.json'), 'utf-8'));
  baseStyles = (meta.inline_styles || []).join('\n');
} catch { /* без блоба — деградация до tokens.css */ }
---
<BaseLayout
  title="Страница не найдена — УралИндуктор"
  description="Запрошенная страница не найдена. Вернитесь на главную сайта УралИндуктор / МТПК или воспользуйтесь поиском."
  index={false}
>
  {baseStyles && <Fragment slot="head" set:html={baseStyles} />}
  <section class="nf">
    <div class="container nf__inner">
      <div class="nf__code">404</div>
      <h1 class="nf__title">Страница не&nbsp;найдена</h1>
      <p class="nf__lead">Возможно, адрес изменился или&nbsp;страница была перемещена.</p>
      <div class="nf__actions">
        <a href="/" class="btn btn--primary">На&nbsp;главную <span class="btn__arrow">→</span></a>
        <button type="button" class="btn btn--secondary" data-search-open>Поиск по&nbsp;сайту</button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf { background: var(--surface-page); padding: clamp(56px, 12vw, 140px) 0; }
  .nf__inner { max-width: 560px; text-align: center; }
  .nf__code {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(96px, 20vw, 200px);
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--teal-600);
    opacity: 0.14;
  }
  .nf__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(24px, 4.5vw, 38px);
    line-height: 1.1;
    margin: clamp(4px, 1.5vw, 12px) 0 0;
    color: var(--text-primary);
  }
  .nf__lead {
    font-size: var(--fs-lead, 18px);
    line-height: 1.5;
    color: var(--text-secondary);
    margin: 14px auto 0;
    max-width: 44ch;
  }
  .nf__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-4, 16px);
    justify-content: center;
    margin-top: clamp(24px, 4vw, 36px);
  }
  .nf__actions .btn { cursor: pointer; }
</style>
