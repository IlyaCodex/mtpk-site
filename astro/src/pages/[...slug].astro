---
import BaseLayout from '../layouts/BaseLayout.astro';
import Adv from '../components/blocks/Adv.astro';
import Adv12 from '../components/blocks/Adv12.astro';
import CatalogCta from '../components/blocks/CatalogCta.astro';
import WhyUs from '../components/blocks/WhyUs.astro';
import WhyUs12 from '../components/blocks/WhyUs12.astro';
import WhyUs6 from '../components/blocks/WhyUs6.astro';
import BestOffer from '../components/blocks/BestOffer.astro';
import Partner from '../components/blocks/Partner.astro';
import Leadgen from '../components/blocks/Leadgen.astro';
import fs from 'node:fs';
import path from 'node:path';
import crypto from 'node:crypto';
import { execSync } from 'node:child_process';

// T-PERF-4: build-time extraction больших inline_styles блоков (>20 KB) в
// external CSS-файлы под /public/css/inline-extracted/inline-<hash>.css.
// Файлы дедуплицируются по содержимому (74 уникальных хэша на 513 страниц),
// HTML каждой страницы уменьшается с 107 KB до ~1 KB. nginx отдаёт CSS с
// max-age=86400 + immutable — на повторных визитах 0 загрузок.
const EXTRACTED_CSS_DIR = path.resolve('./public/css/inline-extracted');
fs.mkdirSync(EXTRACTED_CSS_DIR, { recursive: true });
const cssSeen = new Set<string>();
function extractInlineStyles(blocks: string[]): { external: string[]; inline: string[] } {
  const external: string[] = [];
  const inline: string[] = [];
  for (const block of blocks) {
    // Маленькие блоки (<20 KB) оставляем inline — экономия от внешнего link'а
    // съедается round-trip'ом запроса.
    if (block.length < 20000) {
      inline.push(block);
      continue;
    }
    // Убираем <style>...</style> обёртку — будет в обычный CSS-файл.
    let css = block.replace(/^\s*<style[^>]*>/, '').replace(/<\/style>\s*$/, '');
    // КРИТИЧЕСКИЙ ФИКС: relative urls (url('./img/...'), url("./img/...")) ломаются
    // когда CSS перенесён в /css/inline-extracted/, потому что браузер резолвит их
    // относительно расположения CSS-файла. Переписываем на абсолютные пути.
    css = css.replace(/url\((['"]?)\.\/img\//g, 'url($1/img/');
    css = css.replace(/url\((['"]?)\.\/brand\//g, 'url($1/brand/');
    css = css.replace(/url\((['"]?)\.\.\/img\//g, 'url($1/img/');
    css = css.replace(/url\((['"]?)\.\.\/brand\//g, 'url($1/brand/');
    const hash = crypto.createHash('md5').update(css).digest('hex').slice(0, 12);
    const filename = `inline-${hash}.css`;
    if (!cssSeen.has(hash)) {
      fs.writeFileSync(path.join(EXTRACTED_CSS_DIR, filename), css);
      cssSeen.add(hash);
    }
    external.push(`/css/inline-extracted/${filename}`);
  }
  return { external, inline };
}

const COMPONENTS: Record<string, any> = {
  'adv': Adv,
  'adv-chiller': Adv12,
  'adv-12': Adv12,
  'why-us-12': WhyUs12,
  'why-us-6': WhyUs6,
  'catalog-cta': CatalogCta,
  'why-us': WhyUs,
  'best-offer': BestOffer,
  'partner': Partner,
  'leadgen': Leadgen,
};

export async function getStaticPaths() {
  // Даты публикации страниц из git — один проход по истории на всю сборку.
  // Лог идёт от новых коммитов к старым, поэтому для каждого файла первая
  // встреча даёт дату последней правки, а последняя — дату появления файла.
  // Нужны для Article на кейсах проектов (аудит 02.10.2026, R1).
  // Код живёт здесь, а не рядом с остальными функциями: Astro исполняет
  // getStaticPaths в отдельном модуле, и объявления из области компонента
  // туда не попадают.
  const GIT_PAGE_DATES = new Map<string, { published: string; modified: string }>();
  try {
    const gitRoot = execSync('git rev-parse --show-toplevel', { encoding: 'utf-8' }).trim();
    const log = execSync('git log --format=C:%cI --name-only -- astro/src/raw-pages', {
      cwd: gitRoot, encoding: 'utf-8', maxBuffer: 256 * 1024 * 1024,
    });
    let cur: string | null = null;
    for (const line of log.split(/\r?\n/)) {
      if (line.startsWith('C:')) { cur = line.slice(2); continue; }
      if (!line || !cur) continue;
      const prev = GIT_PAGE_DATES.get(line);
      if (prev) prev.published = cur;            // более старый коммит
      else GIT_PAGE_DATES.set(line, { published: cur, modified: cur });
    }
  } catch (e: any) {
    console.warn('[jsonld] git-даты недоступны:', e.message);
  }

  const rawRoot = path.resolve('./src/raw-pages');
  const paths: any[] = [];
  function walk(dir: string, relPath = '') {
    for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {
      const full = path.join(dir, entry.name);
      const rel = relPath ? `${relPath}/${entry.name}` : entry.name;
      if (entry.isDirectory()) {
        walk(full, rel);
      } else if (entry.name === 'body.html') {
        const body = fs.readFileSync(full, 'utf-8');
        let meta: {
          title: string;
          description: string;
          inline_styles: string[];
          css_templates?: string[];
        } = {
          title: '',
          description: '',
          inline_styles: [],
        };
        const mp = path.join(dir, 'meta.json');
        if (fs.existsSync(mp)) {
          try {
            meta = JSON.parse(fs.readFileSync(mp, 'utf-8'));
          } catch {
            /* keep defaults */
          }
        }
        const gitKey = `astro/src/raw-pages/${rel}`;
        const dates = GIT_PAGE_DATES.get(gitKey) ?? {};
        paths.push({ params: { slug: relPath || undefined }, props: { body, meta, dates } });
      }
    }
  }
  walk(rawRoot);
  return paths;
}

const { body, meta, dates = {} } = Astro.props as {
  body: string;
  meta: {
    title: string;
    description: string;
    inline_styles: string[];
    /** B-3: общие шаблонные CSS-файлы (/css/tpl/<тип>.css), подключаются <link>'ом. */
    css_templates?: string[];
    /** LCP-картинка страницы — добавится в head как preload с fetchpriority=high. */
    preload_image?: string;
    /** Служебная страница: закрыть от поисковиков (<meta robots noindex>). */
    noindex?: boolean;
  };
};
// T-PERF-4: разделяем стили на external (>20 KB → /css/inline-extracted/) и
// оставшийся inline (мелкие page-specific блоки).
const { external: externalStyles, inline: inlineStylesArr } = extractInlineStyles(
  meta.inline_styles || []
);
const inlineStyles = inlineStylesArr.join('\n');
// B-3: общие шаблонные CSS-файлы (вынесены из дубль-блобов). Грузятся <link>'ом
// на той же позиции каскада, что был inline-блоб (после site.css).
const cssTemplates = meta.css_templates || [];
const preloadImage = meta.preload_image;
const _siMatch = body.match(/class="phero__main"[\s\S]*?<img[^>]*?src="([^"]+)"/)
  || body.match(/background-image:\s*url\(['"]?([^'")]+)['"]?\)/)
  || body.match(/<img[^>]*?src="([^"]+)"/);
const searchImage = ((preloadImage || (_siMatch && _siMatch[1]) || '') as string).replace(/\?v=\d+/, '') || undefined;
const slug = Astro.params.slug || '';

let activeNav: string | undefined;
if (slug === '') activeNav = 'home';
else if (slug.startsWith('products')) activeNav = 'catalog';
else if (slug.startsWith('uslugi')) activeNav = 'uslugi';
else if (slug.startsWith('proizvodstvo')) activeNav = 'proizvodstvo';
else if (slug.startsWith('proekty')) activeNav = 'proekty';
else if (slug.startsWith('nalichie')) activeNav = 'nalichie';
else if (slug.startsWith('o-kompanii') || slug.startsWith('o-company')) activeNav = 'o-kompanii';
else if (slug.startsWith('kontakty')) activeNav = 'kontakty';
else if (slug.startsWith('otzyvy')) activeNav = 'otzyvy';

// Поиск (Pagefind):
//  - проекты (/proekty/) НЕ индексируем;
//  - разделы каталога (хаб/категории/подкатегории — у них .cat-hero) получают
//    повышенный вес, чтобы стоять выше товарных карточек (.phero, вес 1).
const isProject = slug.startsWith('proekty');
const isSection = slug.startsWith('products') && body.includes('class="cat-hero"');
// Служебная страница «Спасибо» — не в поисковой выдаче Pagefind (нет смысла
// показывать экран благодарности в результатах поиска по сайту).
// Сравнение товаров — тоже служебная: без выбранных позиций там пусто,
// в поиск и в выдачу она не идёт (noindex + вне sitemap).
const isUtility = slug === 'spasibo' || slug === 'sravnenie';
const searchIndex = !isProject && !isUtility;
const searchWeight = isSection ? 10 : 1;

// SEO-T3b: парсер хлебных крошек → JSON-LD BreadcrumbList.
// Ищем <nav class="breadcrumb"> ... </nav> и извлекаем пары (href, name).
// Последний элемент — обычно <span class="breadcrumb__current"> без href.
const SITE_SEO = 'https://uralinduktor.ru';
// В подписях крошек встречаются типографские сущности (&ndash;, &nbsp; и т.п.) —
// в JSON-LD должен попадать читаемый текст, а не разметка.
function decodeEntities(s: string): string {
  const map: Record<string, string> = {
    '&nbsp;': ' ', '&ndash;': '–', '&mdash;': '—', '&laquo;': '«',
    '&raquo;': '»', '&amp;': '&', '&quot;': '"', '&#8209;': '‑', '&deg;': '°',
  };
  return s.replace(/&[a-z]+;|&#\d+;/gi, (m) => map[m] ?? m).replace(/\s+/g, ' ').trim();
}
// Крошки на сайте размечены тремя способами — исторически, разными пакетами:
//   каталог    <nav class="breadcrumb">  …  <span class="breadcrumb__current">
//   запчасти   <div class="breadcrumbs"> …  последний <span> без класса
//   проекты    <div class="ui-crumb">    …  <span class="ui-crumb-current">
// Разбираем все три, иначе 292 страницы запчастей и 9 кейсов остаются
// без BreadcrumbList (аудит 02.10.2026, задача R1).
function breadcrumbInner(html: string): string | null {
  for (const re of [
    /<nav\s+class="breadcrumb[^"]*"[^>]*>([\s\S]*?)<\/nav>/,
    /<div\s+class="breadcrumbs"[^>]*>([\s\S]*?)<\/div>/,
    /<div\s+class="ui-crumb"[^>]*>([\s\S]*?)<\/div>/,
    // транзисторные запчасти — свой пакет вёрстки
    /<nav\s+class="tr-crumbs"[^>]*>([\s\S]*?)<\/nav>/,
  ]) {
    const m = html.match(re);
    if (m) return m[1];
  }
  return null;
}
function buildBreadcrumbSchema(html: string, pageUrl: string): string | null {
  const inner = breadcrumbInner(html);
  if (!inner) return null;
  const items: { name: string; url?: string }[] = [];
  // <a href="...">name</a>
  const linkRe = /<a\s+href="([^"]+)"[^>]*>([^<]+)<\/a>/g;
  let m: RegExpExecArray | null;
  while ((m = linkRe.exec(inner)) !== null) {
    items.push({ url: m[1], name: decodeEntities(m[2]) });
  }
  // Последняя крошка: со своим классом либо, у запчастей, просто последний
  // <span> без класса (разделители «/» отбрасываем).
  let current: string | null = null;
  const classed = inner.match(/<span\s+class="(?:breadcrumb__current|ui-crumb-current)"[^>]*>([^<]+)<\/span>/);
  if (classed) {
    current = classed[1];
  } else {
    const plain = [...inner.matchAll(/<span(?:\s+aria-current="page")?>([^<]+)<\/span>/g)]
      .map((s) => s[1].trim())
      .filter((t) => t && t !== '/' && !/^\d+\s*\/\s*\d+$/.test(t));
    if (plain.length) current = plain[plain.length - 1];
  }
  if (current) {
    // У последней крошки тоже должен быть item: без него Я.Вебмастер считает
    // цепочку незамкнутой. URL — сама страница (canonical, с trailing slash).
    items.push({ name: decodeEntities(current), url: pageUrl });
  }
  if (items.length < 2) return null;
  const listItems = items.map((it, i) => {
    const item: any = {
      "@type": "ListItem",
      "position": i + 1,
      "name": it.name,
    };
    if (it.url) {
      // Абсолютный URL С trailing slash (синхронизировано с canonical и реальным
      // 200-URL nginx: trailingSlash: 'always'). Иначе schema ссылается на 301.
      let abs = it.url.startsWith('http') ? it.url : `${SITE_SEO}${it.url}`;
      if (!abs.endsWith('/')) abs += '/';
      item.item = abs;
    }
    return item;
  });
  return JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": listItems,
  });
}
// Разделы верхнего уровня (/kontakty/, /otzyvy/, /proekty/) крошек в вёрстке
// не имеют — путь к ним и так однозначен. Цепочку «Главная → страница»
// собираем из адреса и заголовка, чтобы страница не осталась с одной только
// разметкой Organization (аудит 02.10.2026, R1).
function fallbackBreadcrumb(slugPath: string, title: string, pageUrl: string): string | null {
  if (!slugPath || slugPath.includes('/')) return null;
  const name = decodeEntities(title.split('|')[0].replace(/\s*—\s*УралИндуктор\s*$/i, '').trim());
  if (!name) return null;
  return JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Главная", "item": `${SITE_SEO}/` },
      { "@type": "ListItem", "position": 2, "name": name, "item": pageUrl },
    ],
  });
}
const pageUrlAbs = `${SITE_SEO}/${slug}${slug ? '/' : ''}`;
const breadcrumbSchema = buildBreadcrumbSchema(body, pageUrlAbs)
  || fallbackBreadcrumb(slug, meta.title || '', pageUrlAbs);

// SEO-T3c: JSON-LD Product — на товарных страницах (детектор: <section class="phero">).
// Цена не публикуется: стоимость проектная, считается индивидуально. Поэтому НЕ выводим
// offers, price, priceSpecification, lowPrice/highPrice и заглушки вида price: 0 —
// по правилам Google и Яндекса цена в разметке должна совпадать с видимой на странице.
// itemCondition тоже не выводим: это свойство Offer, без offers оно не нужно.
// Вместо цены разметку усиливают данные, которые на странице есть: артикул модели,
// раздел каталога и характеристики из таблицы ТТХ (аудит 01.10.2026, задача P0-2).

// Артикул = модель из заголовка: токен с буквами и цифрами через дефис
// (УИД-326, УИ-0.35Т-300, AC-014, CB-01) либо сплошной код (Y38KKE).
function extractModel(name: string): string | null {
  // \b в JS опирается на ASCII и с кириллицей не срабатывает: границу задаём явно —
  // начало строки, пробел, скобка или кавычка.
  const hyphen = name.match(/(?:^|[\s(«])([A-ZА-Я]{1,4}[-‑][\dА-ЯA-Z][A-Z0-9А-Я.,‑/-]*)/);
  if (hyphen) return hyphen[1].replace(/[.,]+$/, '');
  const solid = name.match(/(?:^|[\s(«])([A-Z]{1,3}\d{2,}[A-Z]*)(?:$|[\s,.)»])/);
  if (solid) return solid[1];
  // Импортные модули называют кодом в конце: «IGBT-модуль FF300R12KS4»,
  // «Тиристор TECHSEM Y38KKE». Берём хвостовой токен, если он набран
  // заглавными латинскими с цифрой — на русских словах не сработает.
  const tail = (name.trim().split(/\s+/).pop() || '');
  if (/^[A-Z0-9][A-Z0-9/.-]{3,}$/.test(tail) && /\d/.test(tail) && /[A-Z]/.test(tail)) return tail;
  // Серии без номера: «Смесители ХТС УИШС», «Вибростол ХТС УИВС». Коды
  // разделов (ХТС, ПГС, ЛВМ, ЛГМ, ТПЧ, ТВЧ) моделью не являются.
  const series = name.match(/(?:^|[\s(«])(УИ[А-ЯЁ]{1,3})(?:$|[\s,.)»])/);
  if (series) return series[1];
  return null;
}

// Раздел каталога — цепочка хлебных крошек без «Главная», «Каталог» и самой страницы.
function extractCategory(html: string): string | null {
  const inner = breadcrumbInner(html);   // все три варианта разметки крошек
  if (!inner) return null;
  const names: string[] = [];
  const re = /<a\s+href="[^"]+"[^>]*>([^<]+)<\/a>/g;
  let m: RegExpExecArray | null;
  while ((m = re.exec(inner)) !== null) names.push(decodeEntities(m[1]));
  const parts = names.filter((n) => !/^(Главная|Каталог оборудования|Каталог)$/i.test(n));
  return parts.length ? parts.join(' / ') : null;
}

// Характеристики — из таблиц .spec-table. Таблиц на странице бывает несколько, и первая
// не всегда с характеристиками (на станках закалки это текстовая врезка), поэтому
// собираем строки из всех. Сначала ключевые (мощность, частота, загрузка, напряжение),
// затем остальные; всего не больше шести.
const KEY_SPECS = /мощность|частота|загрузк|напряжен|производительн|ёмкост|емкост|масса|объём|объем|температур|сечение|расход/i;
function extractProperties(html: string): any[] {
  const tables = html.match(/<table\s+class="spec-table"[^>]*>[\s\S]*?<\/table>/g);
  const rows: { name: string; value: string }[] = [];
  if (tables) {
    const re = /<tr>\s*<th[^>]*>([\s\S]*?)<\/th>\s*<td[^>]*>([\s\S]*?)<\/td>\s*<\/tr>/g;
    let m: RegExpExecArray | null;
    const all = tables.join('');
    while ((m = re.exec(all)) !== null) {
      const name = decodeEntities(m[1].replace(/<[^>]+>/g, ''));
      const value = decodeEntities(m[2].replace(/<[^>]+>/g, ''));
      // «Обозначение в каталоге» уже ушло в sku — в характеристиках не повторяем
      if (name && value && value !== '—' && !/^Обозначение в каталоге$/i.test(name)) {
        rows.push({ name, value });
      }
    }
  }
  // Часть пакетов (ПГС, ЛВМ, ХТС, стержневые, пескоструй, алюминий) верстает
  // характеристики без <th> в строках: шапка «Параметр | Исполнение …»,
  // дальше пары <td>. Берём такие таблицы только если колонок ровно две
  // и первая называется «Параметр» — иначе под разбор попадут таблицы
  // сравнения вида «Задача | Серия | Особенность».
  if (tables) {
    for (const t of tables) {
      const head = t.match(/<thead>([\s\S]*?)<\/thead>/);
      if (!head) continue;
      const ths = head[1].match(/<th[^>]*>([\s\S]*?)<\/th>/g) || [];
      if (ths.length !== 2) continue;
      if (!/параметр|характеристик|показател/i.test(decodeEntities(ths[0].replace(/<[^>]+>/g, '')))) continue;
      const re = /<tr>\s*<td[^>]*>([\s\S]*?)<\/td>\s*<td[^>]*>([\s\S]*?)<\/td>\s*<\/tr>/g;
      let m: RegExpExecArray | null;
      while ((m = re.exec(t)) !== null) {
        const name = decodeEntities(m[1].replace(/<[^>]+>/g, ''));
        const value = decodeEntities(m[2].replace(/<[^>]+>/g, ''));
        if (name && value && value !== '—') rows.push({ name, value });
      }
    }
  }
  // Транзисторные запчасти: таблица .tr-specs в трёх колонках
  // «Параметр | Значение | Условия», заголовков строк нет.
  const trTables = html.match(/<table\s+class="tr-specs"[^>]*>[\s\S]*?<\/table>/g);
  if (trTables) {
    const re = /<tr>\s*<td[^>]*>([\s\S]*?)<\/td>\s*<td[^>]*>([\s\S]*?)<\/td>/g;
    let m: RegExpExecArray | null;
    const all = trTables.join('');
    while ((m = re.exec(all)) !== null) {
      const name = decodeEntities(m[1].replace(/<[^>]+>/g, ''));
      // в значении есть пояснение в <small> («макс.», «допустимый») — убираем
      const value = decodeEntities(m[2].replace(/<small[\s\S]*?<\/small>/g, '').replace(/<[^>]+>/g, ''));
      if (name && value && value !== '—') rows.push({ name, value });
    }
  }
  if (!rows.length) return [];
  const picked = [
    ...rows.filter((r) => KEY_SPECS.test(r.name)),
    ...rows.filter((r) => !KEY_SPECS.test(r.name)),
  ].slice(0, 6);
  return picked.map((r) => {
    // «7,5 кВт» → value 7,5 + unitText кВт; «220 В, 1 фаза» остаётся строкой целиком.
    // Единица обязана начинаться не с цифры, иначе «2 500» разъедется на «2» и «500».
    const split = r.value.match(/^([\d.,]+(?:\s*[–\-×/]\s*[\d.,]+)?)\s+([^\d\s]\S{0,11})$/);
    return split
      ? { '@type': 'PropertyValue', name: r.name, value: split[1], unitText: split[2] }
      : { '@type': 'PropertyValue', name: r.name, value: r.value };
  });
}

function buildProductSchema(html: string, meta: any, canonicalAbs: string): string | null {
  // Две вёрстки товарных страниц: оборудование (.phero) и запчасти
  // (.product-overview, пакет каталога запчастей). У второй нет phero,
  // поэтому 292 карточки оставались без Product (аудит 02.10.2026, R1).
  const isSpare = /<div\s+class="product-overview"/.test(html);
  // третий пакет вёрстки — транзисторные запчасти (IGBT-модули, тиристоры, платы)
  const isTr = /<div\s+class="tr-product-overview"/.test(html);
  if (!/<section\s+class="phero"/.test(html) && !isSpare && !isTr) return null;

  // Имя товара — из h1.phero__title, у запчастей из обычного h1
  const nameMatch = html.match(/<h1\s+class="phero__title"[^>]*>([\s\S]+?)<\/h1>/)
    || ((isSpare || isTr) ? html.match(/<h1[^>]*>([\s\S]+?)<\/h1>/) : null);
  if (!nameMatch) return null;
  const name = nameMatch[1].replace(/<[^>]+>/g, '').replace(/&nbsp;/g, ' ').replace(/\s+/g, ' ').trim();

  // Фото. Главное — носитель .phero__main бывает <button> (с лайтбоксом) и <div>
  // (запчасти, без лайтбокса); src у <img> не всегда первый атрибут. Если у модели
  // есть галерея, в разметку идут её кадры (data-full), а не одна картинка категории.
  const abs = (u: string) =>
    u.startsWith('http') ? u : `${SITE_SEO}${u.replace(/\?v=[\w.]+/, '')}`;
  const imgMatch = html.match(/class="phero__main"[\s\S]*?<img\b[^>]*?\bsrc="([^"]+)"/)
    // запчасти: <button class="product-photo" data-zoom="/img/…"> с полноразмерным кадром
    || (isSpare ? html.match(/class="product-photo"[^>]*\bdata-zoom="([^"]+)"/) : null)
    || (isSpare ? html.match(/class="product-visual"[\s\S]*?<img\b[^>]*?\bsrc="([^"]+)"/) : null)
    || (isTr ? html.match(/class="tr-product-photo"[\s\S]*?\bdata-zoom="([^"]+)"/) : null);
  const gallery = (html.match(/data-full="([^"]+)"/g) || [])
    .map((a) => abs(a.slice(11, -1)));
  // Первым в массиве должно идти фото конкретной модели, а не обложка
  // категории: у галерей первый слайд часто именно обложка (card-baraban.png
  // у всех барабанных дробемётов). Обложки отправляем в конец, порядок
  // остальных сохраняем (аудит 02.10.2026, задача R5).
  const isCategoryShot = (u: string) =>
    /\/(card-|category-)|-main-standard|pech-main-|uid-prokat-photo/.test(u);
  const images = [...new Set([
    ...(imgMatch ? [abs(imgMatch[1])] : []),
    ...gallery,
  ])]
    .map((u, i) => ({ u, i }))
    .sort((a, b) => (isCategoryShot(a.u) ? 1 : 0) - (isCategoryShot(b.u) ? 1 : 0) || a.i - b.i)
    .map((x) => x.u)
    .slice(0, 8);
  if (!images.length) images.push(`${SITE_SEO}/og/default.jpg`);

  const schema: any = {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": name,
    "description": meta.description ?? name,
    "image": images,
    "brand": {
      "@type": "Brand",
      "name": "УралИндуктор"
    },
    "manufacturer": {
      "@id": `${SITE_SEO}/#organization`
    },
    "url": canonicalAbs,
  };
  // У запчастей артикул напечатан в таблице строкой «Обозначение в каталоге»
  // (CB-04, AC-015, ФТ-02) — он точнее, чем разбор заголовка.
  const catalogCode = html.match(/<th[^>]*>\s*Обозначение в каталоге\s*<\/th>\s*<td[^>]*>([^<]+)<\/td>/);
  const model = (catalogCode ? decodeEntities(catalogCode[1]) : null) || extractModel(name);
  if (model) {
    schema.sku = model;
    schema.mpn = model;
  }
  const category = extractCategory(html);
  if (category) schema.category = category;
  const props = extractProperties(html);
  if (props.length) schema.additionalProperty = props;

  return JSON.stringify(schema);
}

// JSON-LD Article — на кейсах /proekty/<город>/ (аудит 02.10.2026, задача R1).
// datePublished берём из git: дата ПЕРВОГО коммита исходника страницы, то есть
// когда кейс появился на сайте. Даты на самой странице («Дата реализации —
// февраль 2026») относятся к проекту, а не к публикации, и подставлять их
// в datePublished нельзя. Нет даты в git (страница не закоммичена) — поле
// не выводим: пустое лучше выдуманного.
function buildArticleSchema(html: string, meta: any, canonicalAbs: string,
                            dates: { published?: string; modified?: string }): string | null {
  if (!/<div\s+class="ui-case"/.test(html)) return null;
  const h1 = html.match(/<h1[^>]*>([\s\S]+?)<\/h1>/);
  if (!h1) return null;
  const headline = decodeEntities(h1[1].replace(/<[^>]+>/g, ''));
  const img = html.match(/class="ui-main-photo"[\s\S]*?<img\b[^>]*?\bsrc="([^"]+)"/)
    || html.match(/class="ui-main-photo"[\s\S]*?\bdata-full="([^"]+)"/);
  const schema: any = {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": headline,
    "description": meta.description ?? headline,
    "url": canonicalAbs,
    "mainEntityOfPage": canonicalAbs,
    "author": { "@id": `${SITE_SEO}/#organization` },
    "publisher": { "@id": `${SITE_SEO}/#organization` },
  };
  if (img) {
    const u = img[1];
    schema.image = [u.startsWith('http') ? u : `${SITE_SEO}${u.replace(/\?v=[\w.]+/, '')}`];
  }
  if (dates.published) schema.datePublished = dates.published;
  if (dates.modified) schema.dateModified = dates.modified;
  return JSON.stringify(schema);
}

// JSON-LD FAQPage — собирается из самого блока вопросов (.faq__item: <summary>
// вопрос + <p class="faq__answer"> ответ). Раньше разметку дублировали руками
// рядом с HTML: при правке текста ответа разметка оставалась старой. Теперь
// источник один — видимый текст страницы, как и требуют Google и Яндекс.
function buildFaqSchema(html: string): string | null {
  const items: { q: string; a: string }[] = [];
  const re = /<details[^>]*class="faq__item"[^>]*>\s*<summary[^>]*>([\s\S]*?)<\/summary>\s*<p[^>]*class="faq__answer"[^>]*>([\s\S]*?)<\/p>/g;
  let m: RegExpExecArray | null;
  while ((m = re.exec(html)) !== null) {
    const q = decodeEntities(m[1].replace(/<[^>]+>/g, ''));
    const a = decodeEntities(m[2].replace(/<[^>]+>/g, ''));
    if (q && a) items.push({ q, a });
  }
  // Вторая форма вопросов на сайте — панель «Вопросы перед заказом…» внутри
  // раздела-документа: заголовок h3 с вопросом и абзац-ответ. Берём только
  // панели с id про вопросы, чтобы риторические подзаголовки других разделов
  // не попали в разметку как FAQ.
  const panel = html.match(/<div class="cdoc__panel" id="[^"]*vopros[^"]*">([\s\S]*?)(?=<div class="cdoc__panel"|<\/div>\s*<\/div>)/);
  if (panel) {
    const qa = /<h3[^>]*>([\s\S]*?)<\/h3>\s*<p[^>]*>([\s\S]*?)<\/p>/g;
    let p: RegExpExecArray | null;
    while ((p = qa.exec(panel[1])) !== null) {
      const q = decodeEntities(p[1].replace(/<[^>]+>/g, ''));
      const a = decodeEntities(p[2].replace(/<[^>]+>/g, ''));
      if (q.endsWith('?') && a) items.push({ q, a });
    }
  }
  if (items.length < 2) return null;   // одиночный вопрос разметкой не считается
  return JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": items.map(({ q, a }) => ({
      "@type": "Question",
      "name": q,
      "acceptedAnswer": { "@type": "Answer", "text": a },
    })),
  });
}
const faqSchema = buildFaqSchema(body);

// canonicalAbs — с trailing slash, как реальный 200-URL (Astro trailingSlash: 'always').
const canonicalAbs = slug ? `${SITE_SEO}/${slug.replace(/\/$/, '')}/` : `${SITE_SEO}/`;
const productSchema = buildProductSchema(body, meta, canonicalAbs);
const articleSchema = buildArticleSchema(body, meta, canonicalAbs, dates as any);

// P2-3 (аудит 01.10.2026): раньше все 16 скриптов ехали на каждую страницу —
// фильтр каталога на контакты, реестр проектов на карточку запчасти. Скрипты
// и так включались сами по наличию своего блока, но файл всё равно скачивался.
// Теперь список считается по содержимому страницы. Маркеры намеренно шире, чем
// нужно скрипту: лишний файл безвреден, недостающий ломает функциональность.
// Общие для всех (меню, маска, формы, скролл) остаются в BaseLayout.
// При правке скрипта поднимай версию ЗДЕСЬ — nginx кэширует /js/ на 7 дней.
const PAGE_SCRIPTS: [string, string, RegExp][] = [
  // галерея и бейджи карточки товара
  ['phero-gallery', '20260914', /class="phero__(media|main)/],
  ['stock-product', '20260623-1', /class="phero"/],
  // «Запросить цену» — дозапись позиции в форму (карточка и плитки каталога)
  ['quote-form', '20260607', /class="(phero__title|pcard)|js-quote-btn/],
  // плитки каталога: наличие, «Сделано в России», сравнение, фильтр
  ['stock-badges', '20260601', /class="pcard/],
  // бейдж «Сделано в России» рисуется на обложках карточек, плиток категорий
  // и тизеров — .cat-card__cover и .teaser-card__cover тоже считаются
  ['made-badges', '20260623-1', /class="(pcard|phero|cat-card__cover|teaser-card__cover)/],
  // кнопка сравнения стоит и в плитке листинга (.pcard__actions),
  // и на странице товара (.phero__actions) — пропустить вторую нельзя
  ['compare', '20260923b', /class="pcard|class="phero__actions|data-compare/],
  ['catalog-filter', '20260601-3', /data-filter-form/],
  // оглавление характеристик
  ['spec-tabs', '20260608-2', /class="spec[\s"]/],
  // каталоги запчастей
  ['zapchasti-catalog', '20260918c', /class="product-card|id="products"/],
  ['zapchasti-tranzistornye', '20260918', /ui-transistor-site|data-catalog/],
  // проекты: реестр и подробный кейс
  ['projects', '20260921a', /id="pr-data"|class="pr-root/],
  ['project-case', '20260921c', /class="ui-case/],
];
const pageScripts: [string, string][] = PAGE_SCRIPTS
  .filter(([, , test]) => test.test(body))
  .map(([name, v]) => [name, v]);

// Split body into segments by block markers <!--C:NAME-->
const parts = body.split(/<!--C:([a-z0-9-]+)-->/);
// parts = [html, name, html, name, html, ...]
type Segment = { type: 'html'; content: string } | { type: 'component'; name: string };
const segments: Segment[] = [];
for (let i = 0; i < parts.length; i++) {
  if (i % 2 === 0) {
    if (parts[i]) segments.push({ type: 'html', content: parts[i] });
  } else {
    segments.push({ type: 'component', name: parts[i] });
  }
}
---
<BaseLayout title={meta.title} description={meta.description} activeNav={activeNav} index={searchIndex} searchWeight={searchWeight} searchImage={searchImage} noindex={meta.noindex === true} pageScripts={pageScripts}>
  {preloadImage && (
    <link slot="head" rel="preload" as="image" href={preloadImage} fetchpriority="high" />
  )}
  {breadcrumbSchema && (
    <script slot="head" type="application/ld+json" set:html={breadcrumbSchema} />
  )}
  {faqSchema && (
    <script slot="head" type="application/ld+json" set:html={faqSchema} />
  )}
  {productSchema && (
    <script slot="head" type="application/ld+json" set:html={productSchema} />
  )}
  {articleSchema && (
    <script slot="head" type="application/ld+json" set:html={articleSchema} />
  )}
  {/* T-PERF-4 + fix FOUC: extracted CSS содержит критические стили layout/header/hero —
      без него браузер рендерит «голый» HTML (SVG растягивается на весь экран).
      Render-blocking обязательно. Файлы immutable + 1 год кэш, повторные визиты бесплатны. */}
  {/* ?v= cache-bust для tpl-CSS: nginx кэширует css на 7d, без версии правки
      шаблонных файлов (например tovar-b.css) не доезжают до вернувшихся юзеров.
      Поднимай дату при правке любого /css/tpl/*.css. */}
  {cssTemplates.map((href) => (
    <link slot="head" rel="stylesheet" href={`${href}?v=20260928a`} />
  ))}
  {externalStyles.map((href) => (
    <link slot="head" rel="stylesheet" href={href} />
  ))}
  {inlineStyles && <Fragment slot="head" set:html={inlineStyles} />}
  {segments.map((seg) => {
    if (seg.type === 'html') return <Fragment set:html={seg.content} />;
    const Comp = COMPONENTS[seg.name];
    return Comp ? <Comp /> : null;
  })}
</BaseLayout>
