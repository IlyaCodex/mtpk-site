---
import BaseLayout from '../layouts/BaseLayout.astro';
import Adv from '../components/blocks/Adv.astro';
import Adv12 from '../components/blocks/Adv12.astro';
import CatalogCta from '../components/blocks/CatalogCta.astro';
import WhyUs from '../components/blocks/WhyUs.astro';
import WhyUs12 from '../components/blocks/WhyUs12.astro';
import WhyUs6 from '../components/blocks/WhyUs6.astro';
import BestOffer from '../components/blocks/BestOffer.astro';
import Partner from '../components/blocks/Partner.astro';
import Leadgen from '../components/blocks/Leadgen.astro';
import fs from 'node:fs';
import path from 'node:path';
import crypto from 'node:crypto';

// T-PERF-4: build-time extraction больших inline_styles блоков (>20 KB) в
// external CSS-файлы под /public/css/inline-extracted/inline-<hash>.css.
// Файлы дедуплицируются по содержимому (74 уникальных хэша на 513 страниц),
// HTML каждой страницы уменьшается с 107 KB до ~1 KB. nginx отдаёт CSS с
// max-age=86400 + immutable — на повторных визитах 0 загрузок.
const EXTRACTED_CSS_DIR = path.resolve('./public/css/inline-extracted');
fs.mkdirSync(EXTRACTED_CSS_DIR, { recursive: true });
const cssSeen = new Set<string>();
function extractInlineStyles(blocks: string[]): { external: string[]; inline: string[] } {
  const external: string[] = [];
  const inline: string[] = [];
  for (const block of blocks) {
    // Маленькие блоки (<20 KB) оставляем inline — экономия от внешнего link'а
    // съедается round-trip'ом запроса.
    if (block.length < 20000) {
      inline.push(block);
      continue;
    }
    // Убираем <style>...</style> обёртку — будет в обычный CSS-файл.
    let css = block.replace(/^\s*<style[^>]*>/, '').replace(/<\/style>\s*$/, '');
    // КРИТИЧЕСКИЙ ФИКС: relative urls (url('./img/...'), url("./img/...")) ломаются
    // когда CSS перенесён в /css/inline-extracted/, потому что браузер резолвит их
    // относительно расположения CSS-файла. Переписываем на абсолютные пути.
    css = css.replace(/url\((['"]?)\.\/img\//g, 'url($1/img/');
    css = css.replace(/url\((['"]?)\.\/brand\//g, 'url($1/brand/');
    css = css.replace(/url\((['"]?)\.\.\/img\//g, 'url($1/img/');
    css = css.replace(/url\((['"]?)\.\.\/brand\//g, 'url($1/brand/');
    const hash = crypto.createHash('md5').update(css).digest('hex').slice(0, 12);
    const filename = `inline-${hash}.css`;
    if (!cssSeen.has(hash)) {
      fs.writeFileSync(path.join(EXTRACTED_CSS_DIR, filename), css);
      cssSeen.add(hash);
    }
    external.push(`/css/inline-extracted/${filename}`);
  }
  return { external, inline };
}

const COMPONENTS: Record<string, any> = {
  'adv': Adv,
  'adv-chiller': Adv12,
  'adv-12': Adv12,
  'why-us-12': WhyUs12,
  'why-us-6': WhyUs6,
  'catalog-cta': CatalogCta,
  'why-us': WhyUs,
  'best-offer': BestOffer,
  'partner': Partner,
  'leadgen': Leadgen,
};

export async function getStaticPaths() {
  const rawRoot = path.resolve('./src/raw-pages');
  const paths: any[] = [];
  function walk(dir: string, relPath = '') {
    for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {
      const full = path.join(dir, entry.name);
      const rel = relPath ? `${relPath}/${entry.name}` : entry.name;
      if (entry.isDirectory()) {
        walk(full, rel);
      } else if (entry.name === 'body.html') {
        const body = fs.readFileSync(full, 'utf-8');
        let meta: {
          title: string;
          description: string;
          inline_styles: string[];
          css_templates?: string[];
        } = {
          title: '',
          description: '',
          inline_styles: [],
        };
        const mp = path.join(dir, 'meta.json');
        if (fs.existsSync(mp)) {
          try {
            meta = JSON.parse(fs.readFileSync(mp, 'utf-8'));
          } catch {
            /* keep defaults */
          }
        }
        paths.push({ params: { slug: relPath || undefined }, props: { body, meta } });
      }
    }
  }
  walk(rawRoot);
  return paths;
}

const { body, meta } = Astro.props as {
  body: string;
  meta: {
    title: string;
    description: string;
    inline_styles: string[];
    /** B-3: общие шаблонные CSS-файлы (/css/tpl/<тип>.css), подключаются <link>'ом. */
    css_templates?: string[];
    /** LCP-картинка страницы — добавится в head как preload с fetchpriority=high. */
    preload_image?: string;
    /** Служебная страница: закрыть от поисковиков (<meta robots noindex>). */
    noindex?: boolean;
  };
};
// T-PERF-4: разделяем стили на external (>20 KB → /css/inline-extracted/) и
// оставшийся inline (мелкие page-specific блоки).
const { external: externalStyles, inline: inlineStylesArr } = extractInlineStyles(
  meta.inline_styles || []
);
const inlineStyles = inlineStylesArr.join('\n');
// B-3: общие шаблонные CSS-файлы (вынесены из дубль-блобов). Грузятся <link>'ом
// на той же позиции каскада, что был inline-блоб (после site.css).
const cssTemplates = meta.css_templates || [];
const preloadImage = meta.preload_image;
const _siMatch = body.match(/class="phero__main"[\s\S]*?<img[^>]*?src="([^"]+)"/)
  || body.match(/background-image:\s*url\(['"]?([^'")]+)['"]?\)/)
  || body.match(/<img[^>]*?src="([^"]+)"/);
const searchImage = ((preloadImage || (_siMatch && _siMatch[1]) || '') as string).replace(/\?v=\d+/, '') || undefined;
const slug = Astro.params.slug || '';

let activeNav: string | undefined;
if (slug === '') activeNav = 'home';
else if (slug.startsWith('products')) activeNav = 'catalog';
else if (slug.startsWith('uslugi')) activeNav = 'uslugi';
else if (slug.startsWith('proizvodstvo')) activeNav = 'proizvodstvo';
else if (slug.startsWith('proekty')) activeNav = 'proekty';
else if (slug.startsWith('nalichie')) activeNav = 'nalichie';
else if (slug.startsWith('o-kompanii') || slug.startsWith('o-company')) activeNav = 'o-kompanii';
else if (slug.startsWith('kontakty')) activeNav = 'kontakty';
else if (slug.startsWith('otzyvy')) activeNav = 'otzyvy';

// Поиск (Pagefind):
//  - проекты (/proekty/) НЕ индексируем;
//  - разделы каталога (хаб/категории/подкатегории — у них .cat-hero) получают
//    повышенный вес, чтобы стоять выше товарных карточек (.phero, вес 1).
const isProject = slug.startsWith('proekty');
const isSection = slug.startsWith('products') && body.includes('class="cat-hero"');
// Служебная страница «Спасибо» — не в поисковой выдаче Pagefind (нет смысла
// показывать экран благодарности в результатах поиска по сайту).
// Сравнение товаров — тоже служебная: без выбранных позиций там пусто,
// в поиск и в выдачу она не идёт (noindex + вне sitemap).
const isUtility = slug === 'spasibo' || slug === 'sravnenie';
const searchIndex = !isProject && !isUtility;
const searchWeight = isSection ? 10 : 1;

// SEO-T3b: парсер хлебных крошек → JSON-LD BreadcrumbList.
// Ищем <nav class="breadcrumb"> ... </nav> и извлекаем пары (href, name).
// Последний элемент — обычно <span class="breadcrumb__current"> без href.
const SITE_SEO = 'https://uralinduktor.ru';
// В подписях крошек встречаются типографские сущности (&ndash;, &nbsp; и т.п.) —
// в JSON-LD должен попадать читаемый текст, а не разметка.
function decodeEntities(s: string): string {
  const map: Record<string, string> = {
    '&nbsp;': ' ', '&ndash;': '–', '&mdash;': '—', '&laquo;': '«',
    '&raquo;': '»', '&amp;': '&', '&quot;': '"', '&#8209;': '‑', '&deg;': '°',
  };
  return s.replace(/&[a-z]+;|&#\d+;/gi, (m) => map[m] ?? m).replace(/\s+/g, ' ').trim();
}
function buildBreadcrumbSchema(html: string, pageUrl: string): string | null {
  const navMatch = html.match(/<nav\s+class="breadcrumb[^"]*"[^>]*>([\s\S]*?)<\/nav>/);
  if (!navMatch) return null;
  const inner = navMatch[1];
  const items: { name: string; url?: string }[] = [];
  // <a href="...">name</a>
  const linkRe = /<a\s+href="([^"]+)"[^>]*>([^<]+)<\/a>/g;
  let m: RegExpExecArray | null;
  while ((m = linkRe.exec(inner)) !== null) {
    items.push({ url: m[1], name: decodeEntities(m[2]) });
  }
  // <span class="breadcrumb__current">...</span>
  const currentMatch = inner.match(/<span\s+class="breadcrumb__current"[^>]*>([^<]+)<\/span>/);
  if (currentMatch) {
    // У последней крошки тоже должен быть item: без него Я.Вебмастер считает
    // цепочку незамкнутой. URL — сама страница (canonical, с trailing slash).
    items.push({ name: decodeEntities(currentMatch[1]), url: pageUrl });
  }
  if (items.length < 2) return null;
  const listItems = items.map((it, i) => {
    const item: any = {
      "@type": "ListItem",
      "position": i + 1,
      "name": it.name,
    };
    if (it.url) {
      // Абсолютный URL С trailing slash (синхронизировано с canonical и реальным
      // 200-URL nginx: trailingSlash: 'always'). Иначе schema ссылается на 301.
      let abs = it.url.startsWith('http') ? it.url : `${SITE_SEO}${it.url}`;
      if (!abs.endsWith('/')) abs += '/';
      item.item = abs;
    }
    return item;
  });
  return JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": listItems,
  });
}
const breadcrumbSchema = buildBreadcrumbSchema(body, `${SITE_SEO}/${slug}${slug ? '/' : ''}`);

// SEO-T3c: JSON-LD Product — на товарных страницах (детектор: <section class="phero">).
// Цена не публикуется: стоимость проектная, считается индивидуально. Поэтому НЕ выводим
// offers, price, priceSpecification, lowPrice/highPrice и заглушки вида price: 0 —
// по правилам Google и Яндекса цена в разметке должна совпадать с видимой на странице.
// itemCondition тоже не выводим: это свойство Offer, без offers оно не нужно.
// Вместо цены разметку усиливают данные, которые на странице есть: артикул модели,
// раздел каталога и характеристики из таблицы ТТХ (аудит 01.10.2026, задача P0-2).

// Артикул = модель из заголовка: токен с буквами и цифрами через дефис
// (УИД-326, УИ-0.35Т-300, AC-014, CB-01) либо сплошной код (Y38KKE).
function extractModel(name: string): string | null {
  // \b в JS опирается на ASCII и с кириллицей не срабатывает: границу задаём явно —
  // начало строки, пробел, скобка или кавычка.
  const hyphen = name.match(/(?:^|[\s(«])([A-ZА-Я]{1,4}[-‑][\dА-ЯA-Z][A-Z0-9А-Я.,‑/-]*)/);
  if (hyphen) return hyphen[1].replace(/[.,]+$/, '');
  const solid = name.match(/(?:^|[\s(«])([A-Z]{1,3}\d{2,}[A-Z]*)(?:$|[\s,.)»])/);
  return solid ? solid[1] : null;
}

// Раздел каталога — цепочка хлебных крошек без «Главная», «Каталог» и самой страницы.
function extractCategory(html: string): string | null {
  const nav = html.match(/<nav\s+class="breadcrumb[^"]*"[^>]*>([\s\S]*?)<\/nav>/);
  if (!nav) return null;
  const names: string[] = [];
  const re = /<a\s+href="[^"]+"[^>]*>([^<]+)<\/a>/g;
  let m: RegExpExecArray | null;
  while ((m = re.exec(nav[1])) !== null) names.push(decodeEntities(m[1]));
  const parts = names.filter((n) => !/^(Главная|Каталог оборудования|Каталог)$/i.test(n));
  return parts.length ? parts.join(' / ') : null;
}

// Характеристики — из таблиц .spec-table. Таблиц на странице бывает несколько, и первая
// не всегда с характеристиками (на станках закалки это текстовая врезка), поэтому
// собираем строки из всех. Сначала ключевые (мощность, частота, загрузка, напряжение),
// затем остальные; всего не больше шести.
const KEY_SPECS = /мощность|частота|загрузк|напряжен|производительн|ёмкост|емкост|масса|объём|объем|температур|сечение|расход/i;
function extractProperties(html: string): any[] {
  const tables = html.match(/<table\s+class="spec-table"[^>]*>[\s\S]*?<\/table>/g);
  if (!tables) return [];
  const rows: { name: string; value: string }[] = [];
  const re = /<tr>\s*<th[^>]*>([\s\S]*?)<\/th>\s*<td[^>]*>([\s\S]*?)<\/td>\s*<\/tr>/g;
  let m: RegExpExecArray | null;
  const all = tables.join('');
  while ((m = re.exec(all)) !== null) {
    const name = decodeEntities(m[1].replace(/<[^>]+>/g, ''));
    const value = decodeEntities(m[2].replace(/<[^>]+>/g, ''));
    if (name && value && value !== '—') rows.push({ name, value });
  }
  const picked = [
    ...rows.filter((r) => KEY_SPECS.test(r.name)),
    ...rows.filter((r) => !KEY_SPECS.test(r.name)),
  ].slice(0, 6);
  return picked.map((r) => {
    // «7,5 кВт» → value 7,5 + unitText кВт; «220 В, 1 фаза» остаётся строкой целиком.
    // Единица обязана начинаться не с цифры, иначе «2 500» разъедется на «2» и «500».
    const split = r.value.match(/^([\d.,]+(?:\s*[–\-×/]\s*[\d.,]+)?)\s+([^\d\s]\S{0,11})$/);
    return split
      ? { '@type': 'PropertyValue', name: r.name, value: split[1], unitText: split[2] }
      : { '@type': 'PropertyValue', name: r.name, value: r.value };
  });
}

function buildProductSchema(html: string, meta: any, canonicalAbs: string): string | null {
  if (!/<section\s+class="phero"/.test(html)) return null;

  // Имя товара — из h1.phero__title
  const nameMatch = html.match(/<h1\s+class="phero__title"[^>]*>([\s\S]+?)<\/h1>/);
  if (!nameMatch) return null;
  const name = nameMatch[1].replace(/<[^>]+>/g, '').replace(/&nbsp;/g, ' ').replace(/\s+/g, ' ').trim();

  // Фото. Главное — носитель .phero__main бывает <button> (с лайтбоксом) и <div>
  // (запчасти, без лайтбокса); src у <img> не всегда первый атрибут. Если у модели
  // есть галерея, в разметку идут её кадры (data-full), а не одна картинка категории.
  const abs = (u: string) =>
    u.startsWith('http') ? u : `${SITE_SEO}${u.replace(/\?v=[\w.]+/, '')}`;
  const imgMatch = html.match(/class="phero__main"[\s\S]*?<img\b[^>]*?\bsrc="([^"]+)"/);
  const gallery = (html.match(/data-full="([^"]+)"/g) || [])
    .map((a) => abs(a.slice(11, -1)));
  const images = [...new Set([
    ...(imgMatch ? [abs(imgMatch[1])] : []),
    ...gallery,
  ])].slice(0, 8);
  if (!images.length) images.push(`${SITE_SEO}/og/default.jpg`);

  const schema: any = {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": name,
    "description": meta.description ?? name,
    "image": images,
    "brand": {
      "@type": "Brand",
      "name": "УралИндуктор"
    },
    "manufacturer": {
      "@id": `${SITE_SEO}/#organization`
    },
    "url": canonicalAbs,
  };
  const model = extractModel(name);
  if (model) {
    schema.sku = model;
    schema.mpn = model;
  }
  const category = extractCategory(html);
  if (category) schema.category = category;
  const props = extractProperties(html);
  if (props.length) schema.additionalProperty = props;

  return JSON.stringify(schema);
}

// canonicalAbs — с trailing slash, как реальный 200-URL (Astro trailingSlash: 'always').
const canonicalAbs = slug ? `${SITE_SEO}/${slug.replace(/\/$/, '')}/` : `${SITE_SEO}/`;
const productSchema = buildProductSchema(body, meta, canonicalAbs);

// Split body into segments by block markers <!--C:NAME-->
const parts = body.split(/<!--C:([a-z0-9-]+)-->/);
// parts = [html, name, html, name, html, ...]
type Segment = { type: 'html'; content: string } | { type: 'component'; name: string };
const segments: Segment[] = [];
for (let i = 0; i < parts.length; i++) {
  if (i % 2 === 0) {
    if (parts[i]) segments.push({ type: 'html', content: parts[i] });
  } else {
    segments.push({ type: 'component', name: parts[i] });
  }
}
---
<BaseLayout title={meta.title} description={meta.description} activeNav={activeNav} index={searchIndex} searchWeight={searchWeight} searchImage={searchImage} noindex={meta.noindex === true}>
  {preloadImage && (
    <link slot="head" rel="preload" as="image" href={preloadImage} fetchpriority="high" />
  )}
  {breadcrumbSchema && (
    <script slot="head" type="application/ld+json" set:html={breadcrumbSchema} />
  )}
  {productSchema && (
    <script slot="head" type="application/ld+json" set:html={productSchema} />
  )}
  {/* T-PERF-4 + fix FOUC: extracted CSS содержит критические стили layout/header/hero —
      без него браузер рендерит «голый» HTML (SVG растягивается на весь экран).
      Render-blocking обязательно. Файлы immutable + 1 год кэш, повторные визиты бесплатны. */}
  {/* ?v= cache-bust для tpl-CSS: nginx кэширует css на 7d, без версии правки
      шаблонных файлов (например tovar-b.css) не доезжают до вернувшихся юзеров.
      Поднимай дату при правке любого /css/tpl/*.css. */}
  {cssTemplates.map((href) => (
    <link slot="head" rel="stylesheet" href={`${href}?v=20260928a`} />
  ))}
  {externalStyles.map((href) => (
    <link slot="head" rel="stylesheet" href={href} />
  ))}
  {inlineStyles && <Fragment slot="head" set:html={inlineStyles} />}
  {segments.map((seg) => {
    if (seg.type === 'html') return <Fragment set:html={seg.content} />;
    const Comp = COMPONENTS[seg.name];
    return Comp ? <Comp /> : null;
  })}
</BaseLayout>
