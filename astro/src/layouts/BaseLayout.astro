---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Drawer from '../components/Drawer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import Analytics from '../components/Analytics.astro';
import fs from 'node:fs';
import path from 'node:path';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  activeNav?: string;
  /** Индексировать ли страницу поиском Pagefind (по умолчанию да). */
  index?: boolean;
  /** Вес страницы для ранжирования поиска (1 — обычная, >1 — приоритетная). */
  searchWeight?: number;
  /** OG image — абсолютный путь от корня (например '/og/foo.jpg'). По умолчанию '/og/default.jpg'. */
  ogImage?: string;
  /** OG type — обычно 'website' (default), для статей — 'article'. */
  ogType?: string;
  /** Картинка-превью для результатов поиска (Pagefind meta image). */
  searchImage?: string;
  /** Закрыть страницу от поисковиков (служебные: сравнение, спасибо). */
  noindex?: boolean;
  /**
   * Скрипты, нужные именно этой странице: массив `['имя', '?v=версия']`.
   * Считается в [...slug].astro по содержимому страницы — скрипт каталога
   * не должен ехать на страницу контактов (аудит 01.10.2026, P2-3).
   */
  pageScripts?: [string, string][];
}
const {
  title, description, canonical, activeNav, index = true, searchWeight = 1,
  ogImage = '/og/default.jpg', ogType = 'website', searchImage, noindex = false,
  pageScripts = [],
} = Astro.props;

// SEO-T1 (v2): canonical URL — С trailing slash, чтобы совпадать с реальным
// 200-URL который отдаёт nginx (Astro trailingSlash: 'always'). Раньше был
// без слеша — nginx делал 301 на версию со слешем, canonical указывал на
// редирект (слабый сигнал для Я/Google). Теперь canonical = sitemap = ссылки.
const SITE = 'https://uralinduktor.ru';
const pathname = Astro.url.pathname;            // '/' | '/products/foo/' | '/nalichie/'
// Гарантируем trailing slash; Astro обычно уже отдаёт с / в конце.
const normalizedPath = pathname.endsWith('/') ? pathname : `${pathname}/`;
const canonicalURL = canonical ?? `${SITE}${normalizedPath}`;

// SEO-T2: Open Graph + Twitter Card — абсолютный URL для og:image и og:url.
const ogImageURL = ogImage.startsWith('http') ? ogImage : `${SITE}${ogImage}`;
const ogDescription = description ?? 'Производим, поставляем и запускаем оборудование для металлургии и литейных производств — индукционные печи, дробемётные установки, чиллеры, ковши.';

// SEO-T3: JSON-LD Organization — единое описание компании для Яндекс.Вебмастера
// и Google Knowledge Graph. Контакты — из site/contact/content.md, соц.сети — из Header/Footer.
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${SITE}/#organization`,
  "name": "УралИндуктор",
  "legalName": "ООО «МТПК»",
  "alternateName": "МТПК-УралИндуктор",
  "url": SITE,
  "logo": {
    "@type": "ImageObject",
    "@id": `${SITE}/brand/logo-color.png`,
    "url": `${SITE}/brand/logo-color.png`,
    "width": 512,
    "height": 512
  },
  "image": `${SITE}/og/default.jpg`,
  "description": "Производство индукционных плавильных печей, дробемётных установок, чиллеров и градирен, сталеразливочных ковшей и оборудования для литейных производств.",
  "telephone": ["+7-800-351-34-01", "+7-351-211-65-97"],
  "email": "info@uralinduktor.ru",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "ул. Уральских Добровольцев, стр. 1В",
    "addressLocality": "Миасс",
    "addressRegion": "Челябинская область",
    "postalCode": "456318",
    "addressCountry": "RU"
  },
  "areaServed": [
    { "@type": "Country", "name": "Россия" },
    { "@type": "Country", "name": "Казахстан" },
    { "@type": "Country", "name": "Беларусь" },
    { "@type": "Country", "name": "Узбекистан" },
    { "@type": "Country", "name": "Кыргызстан" },
    { "@type": "Country", "name": "Таджикистан" },
    { "@type": "Country", "name": "Армения" }
  ],
  "sameAs": [
    "https://t.me/uralinduktor",
    "https://max.ru/uralinduktor"
  ]
};

// T-PERF-8/10/15: Критические CSS встраиваем inline в <head>:
//   - tokens.css           (дизайн-токены)
//   - fonts-critical.css   (4 @font-face — Inter 400/600 latin+cyrillic)
//   - mobile-fixes.css     (правки мобильной вёрстки — критичны на mobile)
//   - stock.css            (бейджи .pcard — мелкий файл)
// Это убирает 2 render-blocking запроса из критического пути (Lighthouse
// показывал stock.css на хвосте цепочки с задержкой 1.8 сек). Остальные
// 14 шрифтов в fonts-extended.css — async (font-display:swap).
const tokensCSS = fs.readFileSync(path.resolve('./public/tokens.css'), 'utf-8');
const fontsCriticalCSS = fs.readFileSync(path.resolve('./public/fonts/fonts-critical.css'), 'utf-8');
const mobileFixesCSS = fs.readFileSync(path.resolve('./public/css/mobile-fixes.css'), 'utf-8');
const stockCSS = fs.readFileSync(path.resolve('./public/css/stock.css'), 'utf-8');
// Атрибуты для <main>: data-pagefind-body включает страницу в индекс, weight — приоритет.
const mainAttrs = index
  ? { 'data-pagefind-body': true, 'data-pagefind-weight': String(searchWeight) }
  : {};
---
<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <!-- Google Search Console — подтверждение прав на сайт (установлено 2026-08-28). -->
  <meta name="google-site-verification" content="klj1lj9utoieH9ZljmhDYykW6XSM3G7dtdVklWGJQw4" />

  <!-- Яндекс.Вебмастер — подтверждение прав. Код тот же, что в файле
       /yandex_5cf3197708e8d0e7.html (Яндекс выдаёт один код на оба способа).
       Держим оба: файл в корне и мета-тег — если один способ слетит, права
       останутся подтверждёнными вторым. -->
  <meta name="yandex-verification" content="5cf3197708e8d0e7" />

  <!-- B242YA — коллтрекинг B242YA (подмена телефона/email, портал uinduktor.bitrix24.ru).
       В <head>, чтобы подмена срабатывала до показа контактов. CSP: *.b242ya.ru.
       async/defer = true (28.09.2026, по замечанию аудита). Парсер скрипт и так
       не блокировал: тег, созданный через createElement и вставленный в DOM,
       грузится асинхронно по умолчанию — defer на такие теги не действует вовсе,
       а async=false лишь выстраивает очередь исполнения среди динамических
       скриптов. Браузер помечает запрос non-blocking, первая отрисовка идёт
       раньше загрузки скрипта. Флаги выставлены явно, чтобы не возвращались. -->
  <script is:inline>
    // B242YA ищет номер по этому классу. Помечаем основной номер до того,
    // как обработчики коллтрекинга начнут сканировать готовый DOM.
    // (правка коллеги от 29.09.2026, перенесена с прода в исходники)
    document.addEventListener('DOMContentLoaded', function () {
      document.querySelectorAll('a[href="tel:+73512116597"]').forEach(function (link) {
        link.classList.add('b242ya-call-tracker');
      });
    }, { once: true });
    (function(w,d,u){
      var s=d.createElement('script');s.defer=true;s.async=true;s.id='b242ya-script';s.src=u+'?'+(Date.now()/60000|0);
      var h=d.getElementsByTagName('script')[0];h.parentNode.insertBefore(s,h);
    })(window,document,'https://67p.b242ya.ru/static/js/b242ya.js');
    var b242yaScript = document.querySelector('#b242ya-script');
    b242yaScript.addEventListener('load', function () {
      B242YAInit({ portal: 'https://uinduktor.bitrix24.ru/', pid: '6de41eb1d932b12cd4ec47ddc85ac1df' });
    });
  </script>

  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  <link rel="canonical" href={canonicalURL} />
  {noindex && <meta name="robots" content="noindex, follow" />}

  <!-- SEO-T2: Open Graph — превью при шеринге (Telegram, VK, WhatsApp, Slack). -->
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={ogDescription} />
  <meta property="og:image" content={ogImageURL} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:site_name" content="УралИндуктор · МТПК" />
  <meta property="og:locale" content="ru_RU" />

  <!-- SEO-T2: Twitter Card — превью в X / LinkedIn. -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={ogDescription} />
  <meta name="twitter:image" content={ogImageURL} />

  <!-- SEO-T3: JSON-LD Organization — единое описание компании для Я.Вебмастера
       (карточка организации) и Google Knowledge Graph. -->
  <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />

  {pathname === '/' && (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "@id": `${SITE}/#website`,
      "url": SITE,
      "name": "УралИндуктор · МТПК",
      "description": "Производство индукционных плавильных печей, дробемётных установок, чиллеров и градирен, сталеразливочных ковшей и оборудования для литейных производств.",
      "publisher": { "@id": `${SITE}/#organization` },
      "inLanguage": "ru-RU",
      "potentialAction": {
        "@type": "SearchAction",
        "target": { "@type": "EntryPoint", "urlTemplate": `${SITE}/?q={search_term_string}` },
        "query-input": {
          "@type": "PropertyValueSpecification",
          "valueRequired": true,
          "valueName": "search_term_string"
        }
      }
    })} />
  )}
  <!-- Self-hosted шрифты + preload основных весов 400/600 cyrillic (T-PERF-2).
       Font-face declarations и design tokens — inline (T-PERF-8), убирают
       2 render-blocking CSS-запроса и весь критический путь рендера сводят
       к одному HTTP-обмену. -->
  <!-- Лого в header — это реальный LCP-элемент по данным Lighthouse.
       Preload + fetchpriority=high → браузер качает картинку параллельно
       с парсингом HTML, к моменту первого пейнта она уже в кеше. -->
  <link rel="preload" as="image" href="/brand/logo-header-clean.png" fetchpriority="high">
  <!-- Preload основных весов Inter 400/600 в latin+cyrillic — параллельно с HTML,
       без них в дереве критических запросов цепочка длиннее (Lighthouse). -->
  <link rel="preload" href="/fonts/inter-400-cyrillic.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/inter-400-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/inter-600-cyrillic.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/inter-600-latin.woff2" as="font" type="font/woff2" crossorigin>
  <style is:global set:html={fontsCriticalCSS}></style>
  <style is:global set:html={tokensCSS}></style>
  <!-- Расширенные шрифты (T-PERF-10) — все остальные веса Inter + JetBrains
       загружаются async после first paint. Lighthouse не флагует их как
       критические зависимости — нет в critical request chain. -->
  <link rel="preload" href="/fonts/fonts-extended.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="/fonts/fonts-extended.css"></noscript>
  <link rel="icon" type="image/x-icon" href="/brand/favicon-original.ico">
  <style is:global>
    /* Honeypot — скрытое поле для ловли ботов (off-screen, не display:none).
       is:global — иначе Astro заскоупит правило на cid слоя, а honeypot живёт
       в компонентах форм (другой cid) и поле станет ВИДИМЫМ. */
    .hp-field { position: absolute !important; left: -9999px !important; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
    /* Статус отправки формы */
    .form-status { margin-top: var(--sp-3, 12px); padding: var(--sp-3, 12px) var(--sp-4, 16px); font-size: var(--fs-small, 14px); line-height: 1.4; }
    .form-status--success { background: var(--status-success-bg, #e8f5e9); color: var(--status-success-fg, #1b5e20); }
    .form-status--error { background: var(--status-error-bg, #fdecea); color: var(--status-error-fg, #b71c1c); }
    .form-status--pending { color: var(--text-secondary, #555); }

    /* Модалка поиска (Pagefind) */
    .search-modal { position: fixed; inset: 0; z-index: 2000; display: flex; align-items: flex-start; justify-content: center; }
    .search-modal[hidden] { display: none; }
    .search-modal__backdrop { position: absolute; inset: 0; background: rgba(16,31,38,.55); backdrop-filter: blur(2px); }
    .search-modal__panel { position: relative; z-index: 1; margin-top: 7vh; width: min(940px, 94vw); max-height: 86vh; display: flex; flex-direction: column; }
    .ss-searchbar { display: flex; align-items: center; gap: 12px; background: #fff; border-radius: 16px; padding: 15px 20px; box-shadow: 0 14px 44px rgba(16,31,38,.20); }
    .ss-searchbar__icon { width: 22px; height: 22px; color: var(--text-tertiary, #8A9298); flex-shrink: 0; }
    .ss-searchbar__input { flex: 1; min-width: 0; border: 0; outline: 0; background: transparent; font-family: var(--font-body, "Inter", sans-serif); font-size: 18px; color: var(--text-primary, #101F26); }
    .ss-searchbar__input::placeholder { color: var(--text-tertiary, #8A9298); }
    .ss-searchbar__clear { border: 0; background: none; cursor: pointer; color: var(--text-tertiary, #8A9298); width: 30px; height: 30px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .ss-searchbar__clear:hover { background: var(--neutral-100, #F0F2F3); color: var(--text-primary, #101F26); }
    .ss-searchbar__clear svg { width: 18px; height: 18px; }
    .ss-results { margin-top: 14px; background: #fff; border-radius: 16px; box-shadow: 0 14px 44px rgba(16,31,38,.16); overflow: auto; padding: 6px; }
    .ss-count { padding: 12px 16px 8px; font-size: 14px; color: var(--text-tertiary, #8A9298); }
    .ss-count b { color: var(--text-primary, #101F26); font-weight: 600; }
    .ss-card { display: flex; gap: 16px; align-items: flex-start; padding: 16px; border-radius: 12px; text-decoration: none; }
    .ss-card:hover { background: var(--surface-subtle, #F5F7F8); }
    .ss-card + .ss-card { border-top: 1px solid var(--border-subtle, #E1E5E7); }
    .ss-card:hover + .ss-card, .ss-card:hover { border-top-color: transparent; }
    .ss-card__body { flex: 1; min-width: 0; }
    .ss-card__title { font-family: var(--font-display, "Inter", sans-serif); font-weight: 600; font-size: 17px; line-height: 1.3; color: var(--text-primary, #101F26); margin: 0 0 5px; }
    .ss-card__excerpt { font-size: 14px; line-height: 1.5; color: var(--text-secondary, #5A6166); margin: 0 0 9px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .ss-card__excerpt mark { background: transparent; color: var(--text-primary, #101F26); font-weight: 600; }
    .ss-card__more { font-family: var(--font-display, "Inter", sans-serif); font-weight: 600; font-size: 13px; letter-spacing: .04em; text-transform: uppercase; color: var(--green-600, #3C8E33); }
    .ss-card__cover { width: 104px; height: 78px; flex-shrink: 0; border-radius: 10px; background: var(--neutral-100, #F0F2F3) center/cover no-repeat; border: 1px solid var(--border-subtle, #E1E5E7); }
    .ss-empty { padding: 30px 16px; text-align: center; color: var(--text-tertiary, #8A9298); font-size: 15px; }
    @media (max-width: 600px) { .ss-card__cover { width: 68px; height: 54px; } .ss-searchbar__input { font-size: 16px; } .ss-card__title { font-size: 16px; } }
  </style>
  <!-- Pagefind CSS подключается lazy при первом открытии модалки (T-PERF-5).
       Заголовок prefetch не блокирует, но сообщает браузеру: «скорее всего пригодится». -->
  <link rel="prefetch" href="/_pagefind/pagefind.js" as="fetch" crossorigin>
  
  <!-- B-2: общее CSS-ядро (445 правил, ~69 KB) — вынесено из meta.json-блобов
       в один файл. Подключается ДО slot=head, чтобы дельты страницы (external/
       inline из [...slug].astro) шли после и могли переопределять ядро.
       Render-blocking + immutable-кэш (nginx max-age) — повторные визиты бесплатны. -->
  <link rel="stylesheet" href="/css/site.css?v=20260929a">
  {/* Оформление пункта «Практикум» в меню и контентных блоков раздела.
      Файл общий с самими страницами практикума (public/praktikum/). */}
  <link rel="stylesheet" href="/css/praktikum-nav-v26.css">
  <slot name="head" />
  <!-- Mobile-fixes + stock-badges — inline в head (T-PERF-15).
       Lighthouse показывал stock.css на хвосте критической цепочки с задержкой
       1.8 сек. Inline убирает 2 HTTP-запроса, max chain delay падает с 1799 до ~300 мс.
       Размер ~7 KB — приемлемо для inline. -->
  <style is:global set:html={mobileFixesCSS}></style>
  <style is:global set:html={stockCSS}></style>
</head>
<body>
  <Header activeNav={activeNav} />
  <main {...mainAttrs}>
    {index && searchImage && (
      <span data-pagefind-meta="image[data-src], image_alt[data-alt]" data-src={searchImage} data-alt={title} style="display:none"></span>
    )}
    <slot />
  </main>
  <Footer />
  <Drawer />
  <CookieConsent />
  <!-- Cache-bust версии: nginx отдаёт /js/*.js и /css/*.css с max-age=7д,
       при правке файла поднимай ?v= — иначе пользователи получат старую версию. -->
  <!-- Общие для всех страниц: меню, маска телефона, отправка заявок и скролл
       к форме. Форма обратного звонка стоит в шапке, поэтому три последних
       нужны везде, включая 404. -->
  <script src="/js/mobile-nav.js?v=20260601" defer></script>
  <script src="/js/phone-mask.js?v=20260601" defer></script>
  <script src="/js/forms.js?v=20260910" defer></script>
  <!-- Единое правило скролла к форме заявки (#leadgen/#contacts → к самой форме). -->
  <script src="/js/scroll-to-form.js?v=20260608" defer></script>
  <!-- Остальное — только там, где на странице есть соответствующий блок.
       Список собирает [...slug].astro, см. PAGE_SCRIPTS. -->
  {pageScripts.map(([name, v]) => (
    <script src={`/js/${name}.js?v=${v}`} defer></script>
  ))}
  <script>
    /* T-PERF-9: scroll listener — обёрнут в requestAnimationFrame, чтобы
       избежать forced reflow (классификация Lighthouse — «принудительная
       компоновка»). window.scrollY читается в rAF-кадре, а не на каждом
       scroll-event, и не дёргает layout посреди painting. */
    (function(){
      const h = document.querySelector('.header-shell');
      if (!h) return;
      let ticking = false;
      const apply = () => {
        h.classList.toggle('is-scrolled', window.scrollY > 8);
        ticking = false;
      };
      window.addEventListener('scroll', () => {
        if (!ticking) { requestAnimationFrame(apply); ticking = true; }
      }, { passive: true });
      apply();
    })();
  </script>

  <!-- Поиск по сайту (Pagefind). Индекс /_pagefind/ создаётся командой
       `npx pagefind --site dist` после сборки. Модалка открывается по «лупе». -->
  <div class="search-modal" id="search-modal" hidden>
    <div class="search-modal__backdrop" data-search-close></div>
    <div class="search-modal__panel" role="dialog" aria-modal="true" aria-label="Поиск по сайту">
      <div class="ss-searchbar">
        <svg class="ss-searchbar__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
        <input type="text" id="ss-input" class="ss-searchbar__input" placeholder="Поиск оборудования…" autocomplete="off" aria-label="Поиск по сайту">
        <button class="ss-searchbar__clear" type="button" aria-label="Закрыть поиск" data-search-close><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 6l12 12M18 6l-12 12"/></svg></button>
      </div>
      <div class="ss-results" id="ss-results" hidden>
        <div class="ss-count" id="ss-count" hidden></div>
        <div class="ss-list" id="ss-list"></div>
        <div class="ss-empty" id="ss-empty" hidden></div>
      </div>
    </div>
  </div>
  <!-- Pagefind lazy loader (T-PERF-5): CSS + JS подгружаются динамически
       при первом клике на кнопку поиска. До этого -35 KB JS и -7 KB CSS
       из критического пути на каждой из 513 страниц. -->
  <script is:inline>
    (function () {
      var modal = document.getElementById('search-modal');
      if (!modal) return;
      var input = document.getElementById('ss-input');
      var results = document.getElementById('ss-results');
      var list = document.getElementById('ss-list');
      var countEl = document.getElementById('ss-count');
      var emptyEl = document.getElementById('ss-empty');
      var pf = null, loadingPromise = null, timer = null, lastQuery = '';

      function loadPagefind() {
        if (pf) return Promise.resolve(pf);
        if (loadingPromise) return loadingPromise;
        loadingPromise = import('/_pagefind/pagefind.js').then(function (mod) {
          pf = mod; if (pf.init) { try { pf.init(); } catch (e) {} } return pf;
        });
        return loadingPromise;
      }
      function esc(s) { return (s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;'); }

      function renderData(items, total, q) {
        if (q !== lastQuery) return;
        results.hidden = false; countEl.hidden = false;
        countEl.innerHTML = 'Найдено: <b>' + total + '</b>';
        if (!total) { list.innerHTML = ''; emptyEl.hidden = false; emptyEl.textContent = 'Ничего не найдено по запросу «' + q + '»'; return; }
        emptyEl.hidden = true;
        list.innerHTML = items.map(function (d) {
          var img = d.meta && d.meta.image;
          var cover = img ? '<div class="ss-card__cover" style="background-image:url(\'' + esc(img) + '\')"></div>' : '';
          var title = esc((d.meta && d.meta.title) || d.url);
          var ex = d.excerpt || '';
          return '<a class="ss-card" href="' + esc(d.url) + '"><div class="ss-card__body">' +
            '<div class="ss-card__title">' + title + '</div>' +
            '<div class="ss-card__excerpt">' + ex + '</div>' +
            '<span class="ss-card__more">Подробнее →</span></div>' + cover + '</a>';
        }).join('');
      }

      function relevant(d, q) {
        var words = q.toLowerCase().split(/\s+/).filter(function (w) { return w.length >= 2; });
        if (!words.length) return true;
        var hay = (((d.meta && d.meta.title) || '') + ' ' + (d.excerpt || '').replace(/<[^>]+>/g, '')).toLowerCase();
        return words.every(function (w) { var stem = w.length >= 3 ? w.slice(0, 3) : w; return hay.indexOf(stem) !== -1; });
      }
      function doSearch(q) {
        lastQuery = q;
        if (!q || q.trim().length < 2) { results.hidden = true; countEl.hidden = true; emptyEl.hidden = true; list.innerHTML = ''; return; }
        loadPagefind().then(function () { return pf.search(q); }).then(function (res) {
          if (q !== lastQuery) return;
          Promise.all(res.results.slice(0, 40).map(function (r) { return r.data(); })).then(function (all) {
            if (q !== lastQuery) return;
            var items = all.filter(function (d) { return relevant(d, q); });
            renderData(items, items.length, q);
          });
        }).catch(function () {});
      }

      if (input) input.addEventListener('input', function () { var q = input.value; clearTimeout(timer); timer = setTimeout(function () { doSearch(q); }, 160); });

      function open() { modal.hidden = false; document.documentElement.style.overflow = 'hidden'; loadPagefind(); setTimeout(function () { if (input) input.focus(); }, 60); }
      function close() { modal.hidden = true; document.documentElement.style.overflow = ''; }
      document.querySelectorAll('[data-search-open]').forEach(function (b) { b.addEventListener('click', open); });
      modal.querySelectorAll('[data-search-close]').forEach(function (b) { b.addEventListener('click', close); });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !modal.hidden) close(); });
    })();
  </script>

