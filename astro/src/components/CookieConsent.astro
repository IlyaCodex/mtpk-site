---
/*
 * CookieConsent.astro — плашка согласия на cookie / веб-аналитику.
 * Подключается в конце <body> через BaseLayout (на всех страницах).
 *
 * Логика: при первом визите (нет флага ui_cookie_consent) показываем баннер;
 * до нажатия «Принять» аналитика (Метрика/Roistat/Top.Mail) НЕ запускается
 * (см. Analytics.astro — старт по событию cookie-consent-accepted). «Принять»
 * пишет флаг в localStorage + cookie и диспатчит событие запуска аналитики.
 * Версия согласия — CONSENT_VERSION (совпадает с send.php / формами).
 */
const CONSENT_VERSION = 'v2026.1';
---
<div class="cookie-consent" id="cookie-consent" data-consent-version={CONSENT_VERSION} hidden aria-live="polite">
  <div class="cookie-consent__inner">
    <p class="cookie-consent__text">
      Мы&nbsp;используем файлы cookie и&nbsp;сервис веб-аналитики Яндекс&nbsp;Метрика для&nbsp;сбора
      технических данных, обеспечения корректной работы сайта и&nbsp;анализа посещаемости.
      Продолжая использовать сайт, вы&nbsp;соглашаетесь на&nbsp;обработку этих данных
      в&nbsp;соответствии с&nbsp;<a href="/policy/" target="_blank" rel="noopener">Политикой обработки персональных данных</a>.
    </p>
    <div class="cookie-consent__actions">
      <a class="cookie-consent__more" href="/policy/" target="_blank" rel="noopener">Подробнее</a>
      <button type="button" class="cookie-consent__accept" id="cookie-accept">Принять</button>
    </div>
  </div>
</div>

<style is:global>
  .cookie-consent {
    position: fixed;
    left: 0; right: 0; bottom: 0;
    z-index: 3000;
    background: var(--neutral-950, #0f2027);
    color: var(--neutral-0, #fff);
    border-top: 3px solid var(--teal-600, #1F5E78);
    box-shadow: 0 -10px 40px -12px rgba(0,0,0,.5);
    animation: cookie-up .3s ease-out;
  }
  .cookie-consent[hidden] { display: none; }
  @keyframes cookie-up { from { transform: translateY(100%); } to { transform: translateY(0); } }
  .cookie-consent__inner {
    max-width: 1280px; margin: 0 auto;
    padding: 16px 24px;
    display: flex; align-items: center; gap: 24px;
  }
  .cookie-consent__text {
    margin: 0; flex: 1;
    font-family: var(--font-body, "Inter", sans-serif);
    font-size: 14px; line-height: 1.5;
    color: rgba(255,255,255,.86);
  }
  .cookie-consent__text a { color: var(--green-400, #6CC957); text-decoration: underline; }
  .cookie-consent__actions { display: flex; align-items: center; gap: 12px; flex-shrink: 0; }
  .cookie-consent__more {
    font-family: var(--font-display, "Inter", sans-serif);
    font-size: 13px; font-weight: 600;
    color: rgba(255,255,255,.75); text-decoration: none; white-space: nowrap;
    padding: 10px 6px;
  }
  .cookie-consent__more:hover { color: #fff; text-decoration: underline; }
  .cookie-consent__accept {
    appearance: none; border: 0; cursor: pointer;
    background: var(--green-500, #4CAF50); color: #fff;
    font-family: var(--font-display, "Inter", sans-serif);
    font-size: 14px; font-weight: 700; text-transform: uppercase; letter-spacing: .04em;
    padding: 12px 28px; border-radius: 8px; white-space: nowrap;
    transition: background .18s;
  }
  .cookie-consent__accept:hover { background: var(--green-600, #3d8a2c); }
  @media (max-width: 720px) {
    .cookie-consent__inner { flex-direction: column; align-items: stretch; gap: 12px; padding: 14px 16px; }
    .cookie-consent__actions { justify-content: space-between; }
    .cookie-consent__accept { flex: 1; padding: 12px 16px; }
  }
</style>

<script is:inline>
(function () {
  var KEY = 'ui_cookie_consent';
  var el = document.getElementById('cookie-consent');
  if (!el) return;
  var version = el.getAttribute('data-consent-version') || 'v1';

  function stored() {
    try { return localStorage.getItem(KEY); } catch (e) {}
    // fallback cookie
    var m = document.cookie.match(/(?:^|; )ui_cookie_consent=([^;]*)/);
    return m ? decodeURIComponent(m[1]) : null;
  }
  // Уже согласились — баннер не показываем (аналитику поднимет Analytics.astro сам).
  if (stored()) return;

  el.hidden = false;

  var btn = document.getElementById('cookie-accept');
  if (btn) btn.addEventListener('click', function () {
    var val = '1|' + version + '|' + new Date().toISOString();
    try { localStorage.setItem(KEY, val); } catch (e) {}
    try {
      var d = new Date(); d.setTime(d.getTime() + 365 * 864e5);
      document.cookie = KEY + '=' + encodeURIComponent(val) + ';expires=' + d.toUTCString() + ';path=/;SameSite=Lax';
    } catch (e) {}
    el.hidden = true;
    // Запускаем аналитику (Метрика/Roistat/Top.Mail) после согласия.
    try { window.dispatchEvent(new Event('cookie-consent-accepted')); } catch (e) {}
  });
})();
</script>
