---
/*
 * Analytics.astro — единый контейнер сторонних аналитических скриптов.
 * Подключается в конце <body> на ВСЕХ страницах через BaseLayout.astro.
 *
 * Счётчики (см. briefs/forms-spec.md, раздел «Аналитика»):
 *   - Яндекс.Метрика — счётчики 25228307 (кабинет УралИндуктор3)
 *                      и 112991420 (кабинет uibusiness, добавлен 29.09.2026)
 *   - Top.Mail.Ru    — counter 3784620
 *   - Битрикс24      — сквозная аналитика / call tracker (портал b1785973)
 *
 * Все сторонние <script> помечены is:inline — иначе Astro попытается их
 * собрать/обработать и сломает (особенно код с document.write).
 *
 * T-PERF-12 (2026-06-01): инициализация отложена через requestIdleCallback
 * до момента, когда браузер закончит первый рендер. Trade-off: первые
 * 1-3 секунды посетитель не трекается, но FCP/LCP не пьют 75 KB сторонних
 * скриптов и Lighthouse не помечает их как unused-on-critical-path.
 * Все user-interaction (клик, скролл, тач, key-press) форсят немедленный
 * запуск — никто не потеряется.
 */
---
<!-- Аналитика откладывается до idle / first interaction (T-PERF-12) -->
<script is:inline>
(function(){
  var started = false;
  function startAnalytics(){
    if (started) return;
    started = true;

    /* ===== Яндекс.Метрика ===== */
    (function(m,e,t,r,i,k,a){
      m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
      m[i].l=1*new Date();
      for (var j = 0; j < document.scripts.length; j++) { if (document.scripts[j].src === r) { return; } }
      k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,
      a.parentNode.insertBefore(k,a)
    })(window, document,'script','https://mc.yandex.ru/metrika/tag.js', 'ym');
    [25228307, 112991420].forEach(function(counterId){
      ym(counterId, 'init', {
        webvisor: true, clickmap: true,
        referrer: document.referrer, url: location.href,
        accurateTrackBounce: true, trackLinks: true
      });
    });

    /* ===== Top.Mail.Ru (VK) — counter 3784620 ===== */
    var _tmr = window._tmr || (window._tmr = []);
    _tmr.push({id: "3784620", type: "pageView", start: (new Date()).getTime()});
    (function (d, w, id) {
      if (d.getElementById(id)) return;
      var ts = d.createElement("script"); ts.type = "text/javascript"; ts.async = true; ts.id = id;
      ts.src = "https://top-fwz1.mail.ru/js/code.js";
      var f = function () {var s = d.getElementsByTagName("script")[0]; s.parentNode.insertBefore(ts, s);};
      if (w.opera == "[object Opera]") { d.addEventListener("DOMContentLoaded", f, false); } else { f(); }
    })(document, window, "tmr-code");
  }

  /* Cookie-согласие: до нажатия «Принять» аналитику НЕ запускаем (152-ФЗ /
     GDPR-подход). Флаг ставит CookieConsent.astro. */
  function hasConsent(){
    try { if (localStorage.getItem('ui_cookie_consent')) return true; } catch(e){}
    return /(?:^|; )ui_cookie_consent=/.test(document.cookie);
  }
  /* Отложенный старт: requestIdleCallback (Chrome/Firefox/Edge) или
     setTimeout fallback на 2.5 сек для Safari/старых, + запуск по первому
     взаимодействию, чтобы не терять hit от активного пользователя. */
  function armStart(){
    if ('requestIdleCallback' in window) {
      requestIdleCallback(startAnalytics, { timeout: 4000 });
    } else {
      setTimeout(startAnalytics, 2500);
    }
    ['pointerdown','touchstart','keydown','scroll'].forEach(function(ev){
      window.addEventListener(ev, startAnalytics, { once: true, passive: true });
    });
  }

  /* Страница во фрейме = инструменты Яндекс.Метрики (карты ссылок/кликов/
     скроллинга, Вебвизор, «Взаимодействие с сайтом»). Счётчик нужен сразу,
     иначе Метрика пишет «код счётчика не установлен». CSP frame-ancestors
     пускает во фрейм только Метрику — сторонних сайтов тут быть не может. */
  function inFrame(){ try { return window.top !== window.self; } catch(e){ return true; } }

  if (inFrame()) {
    startAnalytics();
  } else if (hasConsent()) {
    armStart();
  } else {
    /* Согласия ещё нет — ждём «Принять» в cookie-баннере. */
    window.addEventListener('cookie-consent-accepted', startAnalytics);
  }
})();
</script>
