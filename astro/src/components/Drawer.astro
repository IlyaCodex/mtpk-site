---
/* Мобильное меню. Пункты — карточками с иконкой слева, у раскрываемых
   справа шевron (правка 05.10.2026 по референсу Евгения).

   Иконки — набор Lucide (лицензия ISC), контурные 24×24 со stroke:
   currentColor, как уже сделанные иконки сайта (телефон, почта, часы в
   шапке). Вставлены прямо в разметку: по ~250 байт каждая, зато без
   лишнего запроса и красятся через color вместе с текстом.
   svgrepo.com, который предлагал Евгений, отдаёт 429 и на fetch, и на
   запрос из браузера — блокирует по IP, иконки оттуда не скачиваются. */
const ICONS: Record<string, string> = {
  catalog: '<rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/>',
  services: '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.106-3.105c.32-.322.863-.22.983.218a6 6 0 0 1-8.259 7.057l-7.91 7.91a1 1 0 0 1-2.999-3l7.91-7.91a6 6 0 0 1 7.057-8.259c.438.12.54.662.219.984z"/>',
  stock: '<path d="M11 21.73a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73z"/><path d="M12 22V12"/><polyline points="3.29 7 12 12 20.71 7"/><path d="m7.5 4.27 9 5.15"/>',
  projects: '<path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/>',
  company: '<path d="M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/><rect width="20" height="14" x="2" y="6" rx="2"/>',
  contacts: '<path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384"/>',
  reviews: '<path d="M14 14a2 2 0 0 0 2-2V8h-2"/><path d="M22 17a2 2 0 0 1-2 2H6.828a2 2 0 0 0-1.414.586l-2.202 2.202A.71.71 0 0 1 2 21.286V5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2z"/><path d="M8 14a2 2 0 0 0 2-2V8H8"/>',
  praktikum: '<path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"/><path d="M22 10v6"/><path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5"/>',
  mail: '<path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7"/><rect x="2" y="4" width="20" height="16" rx="2"/>',
};
const icon = (name: string) =>
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${ICONS[name]}</svg>`;

// Простые пункты: подпись, адрес, иконка.
const LINKS: [string, string, string][] = [
  ['Наличие', '/nalichie/', 'stock'],
  ['Проекты', '/proekty/', 'projects'],
  ['О&nbsp;компании', '/o-company/', 'company'],
  ['Контакты', '/kontakty/', 'contacts'],
  ['Отзывы', '/otzyvy/', 'reviews'],
  ['Практикум', '/praktikum/', 'praktikum'],
];
---
<aside class="nav-drawer" aria-hidden="true" data-nav-drawer>
  <div class="nav-drawer__header">
    {/* Логотип вместо текстового «УралИндуктор» (просьба Евгения 05.10.2026).
        Тот же файл, что в шапке, — он уже в кэше браузера. */}
    <a href="/" class="nav-drawer__brand" aria-label="УралИндуктор — на главную">
      <img src="/brand/logo-header-clean.png" alt="УралИндуктор"
           width="200" height="56" loading="lazy" decoding="async">
    </a>
    <button class="nav-drawer__close" aria-label="Закрыть меню" data-nav-close>&times;</button>
  </div>

  <ul class="nav-drawer__list">
    <!-- Каталог — раскрываемый -->
    <li class="nav-drawer__item nav-drawer__item--acc">
      <button class="nav-drawer__acc" type="button" data-drawer-acc aria-expanded="false">
        <span class="nav-drawer__icon" aria-hidden="true" set:html={icon('catalog')} />
        <span class="nav-drawer__text">Каталог</span>
        <span class="nav-drawer__acc-chev" aria-hidden="true"></span>
      </button>
      <div class="nav-drawer__panel">
        <div class="nav-drawer__group-label">Плавка и&nbsp;обработка металлов</div>
        <a class="nav-drawer__sublink" href="/products/induktsionnye-plavilnye-pechi/">Индукционные плавильные печи</a>
        <a class="nav-drawer__sublink" href="/products/induktsionnye-nagrevateli/">Индукционные нагреватели</a>
        <a class="nav-drawer__sublink" href="/products/drobemetnoe-oborudovanie/">Дробемётные установки</a>
        <a class="nav-drawer__sublink" href="/products/sistemy-ohlazhdeniya/">Системы охлаждения</a>
        <div class="nav-drawer__group-label">Производственные линии</div>
        <a class="nav-drawer__sublink" href="/products/linii-dlya-holodnotverdeyushhih-smesej-hts/">ХТС — холодно-твердеющие смеси</a>
        <a class="nav-drawer__sublink" href="/products/oborudovanie-lvm/">ЛВМ — литьё по&nbsp;выплавляемым моделям</a>
        <a class="nav-drawer__sublink" href="/products/oborudovanie-lgm/">ЛГМ — литьё по&nbsp;газифицируемым моделям</a>
        <a class="nav-drawer__sublink" href="/products/oborudovanie-dlya-peschano-glinistyh-smesej-pgs/">ПГС — песчано-глинистые смеси</a>
        <a class="nav-drawer__sublink nav-drawer__sublink--all" href="/products/">Весь каталог&nbsp;&rarr;</a>
      </div>
    </li>

    <!-- Услуги — раскрываемый -->
    <li class="nav-drawer__item nav-drawer__item--acc">
      <button class="nav-drawer__acc" type="button" data-drawer-acc aria-expanded="false">
        <span class="nav-drawer__icon" aria-hidden="true" set:html={icon('services')} />
        <span class="nav-drawer__text">Услуги</span>
        <span class="nav-drawer__acc-chev" aria-hidden="true"></span>
      </button>
      <div class="nav-drawer__panel">
        <a class="nav-drawer__sublink" href="/uslugi/puskonaladka/">Пусконаладка</a>
        <a class="nav-drawer__sublink" href="/uslugi/montazh-shefmontazh/">Монтаж и&nbsp;шефмонтаж</a>
        <a class="nav-drawer__sublink" href="/uslugi/obuchenie-personala/">Обучение персонала</a>
        <a class="nav-drawer__sublink" href="/uslugi/remont-plavilnyh-pechey/">Ремонт плавильных печей</a>
        <a class="nav-drawer__sublink" href="/uslugi/remont-drobemetov/">Ремонт дробемётов</a>
        <a class="nav-drawer__sublink" href="/uslugi/tehnicheskij-audit/">Технический аудит</a>
      </div>
    </li>

    {LINKS.map(([label, href, name]) => (
      <li class="nav-drawer__item">
        <a class="nav-drawer__link" href={href}>
          <span class="nav-drawer__icon" aria-hidden="true" set:html={icon(name)} />
          <span class="nav-drawer__text" set:html={label} />
        </a>
      </li>
    ))}
  </ul>

  <div class="nav-drawer__contacts">
    <div class="nav-drawer__contacts-label">Связаться</div>
    <a href="tel:+78003513401">
      <span class="nav-drawer__contact-icon" aria-hidden="true" set:html={icon('contacts')} />8&nbsp;800&nbsp;351-34-01
    </a>
    <a href="tel:+73512116597">
      <span class="nav-drawer__contact-icon" aria-hidden="true" set:html={icon('contacts')} />+7 (351) 211-65-97
    </a>
    <a href="mailto:info@uralinduktor.ru">
      <span class="nav-drawer__contact-icon" aria-hidden="true" set:html={icon('mail')} />info@uralinduktor.ru
    </a>
  </div>
</aside>
