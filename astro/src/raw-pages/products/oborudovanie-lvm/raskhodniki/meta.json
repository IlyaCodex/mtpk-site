{
  "title": "Расходные материалы для участка ЛВМ",
  "description": "Модельный, клеящий и ремонтный воск, а также смачиватели для керамической суспензии ЛВМ. Подбор материалов под процесс заказчика.",
  "css_templates": [
    "/css/tpl/tovar-b.css"
  ],
  "inline_styles": [
    "<style>html{scroll-behavior:smooth}.spec__nav-link.is-active{color:var(--text-brand);border-left-color:var(--teal-600);font-weight:600}.spec__body{min-width:0}.matgrid{display:flex;flex-direction:column;gap:var(--sp-8)}.matcard{display:grid;grid-template-columns:220px 1fr;gap:var(--sp-8);align-items:start}.matcard+.matcard{padding-top:var(--sp-8);border-top:1px solid var(--border-subtle)}.matcard__media{aspect-ratio:1;overflow:hidden;background:var(--surface-muted);border:1px solid var(--border-subtle);padding:0;cursor:zoom-in;display:block;width:100%;transition:border-color var(--duration-fast) var(--ease-out)}.matcard__media:hover{border-color:var(--teal-600)}.matcard__media img{width:100%;height:100%;object-fit:contain}.matcard__title{font-family:var(--font-display);font-size:var(--fs-h5);font-weight:var(--fw-semibold);letter-spacing:var(--ls-h5);color:var(--text-primary);margin:0 0 var(--sp-3)}.matcard__body>*+*{margin-top:var(--sp-3)}@media(max-width:640px){.matcard{grid-template-columns:1fr}.matcard__media{max-width:280px}}</style>"
  ]
}
