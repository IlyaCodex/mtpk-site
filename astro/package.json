{
  "name": "uralinduktor-astro",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "stock": "node scripts/build-stock.mjs --verbose",
    "prebuild": "node scripts/build-stock.mjs && node scripts/build-compare-index.mjs",
    "build": "astro build",
    "seo": "node ../scripts/seo-check.mjs dist",
    "postbuild": "pagefind --site dist --output-subdir _pagefind && node scripts/prune-inline-extracted.mjs && node scripts/strip-html-comments.mjs",
    "preview": "astro preview",
    "compare": "node scripts/build-compare-index.mjs --report"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^6.3.8"
  },
  "devDependencies": {
    "pagefind": "^1.5.2",
    "playwright": "^1.60.0"
  }
}
