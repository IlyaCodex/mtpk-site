# Диск C у разработчика один. npm и так берёт уже скачанные архивы пакетов
# из существующего глобального кеша (по хешу содержимого), поэтому отдельный
# кеш проекта не заводим. prefer-offline не включаем: с ним npm читает
# устаревшие метаданные и не находит свежие версии (ETARGET).
fund=false
audit=false
update-notifier=false
