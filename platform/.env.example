# ============================================================================
# Платформа uralinduktor.ru — переменные окружения.
# Для локальной разработки: скопировать в .env (cp .env.example .env).
# В проде значения задаются в .env рядом с docker-compose.yml на сервере.
# Секреты (SMTP, вебхук Битрикс24, ключи S3) НЕ коммитить.
# ============================================================================

NODE_ENV=development
LOG_LEVEL=info
# Канонический адрес сайта: canonical, og:url, sitemap, JSON-LD.
SITE_URL=https://uralinduktor.ru

# --- PostgreSQL ---------------------------------------------------------------
DATABASE_URL=postgres://mtpk:mtpk_dev_password@127.0.0.1:5442/mtpk
# пустая служебная база: сверка миграций со схемой (prisma migrate diff --from-migrations)
SHADOW_DATABASE_URL=postgres://mtpk:mtpk_dev_password@127.0.0.1:5442/mtpk_shadow

# --- Redis (кеш, очередь заявок, события контента) ---------------------------
REDIS_URL=redis://127.0.0.1:6392

# --- S3: сейчас MinIO, потом Wasabi (меняются только эти строки) --------------
# Wasabi: S3_ENDPOINT=https://s3.eu-central-1.wasabisys.com, S3_REGION=eu-central-1,
#         S3_FORCE_PATH_STYLE=false, имена бакетов — глобально уникальные.
S3_ENDPOINT=http://127.0.0.1:9010
S3_REGION=us-east-1
S3_ACCESS_KEY=mtpk
S3_SECRET_KEY=mtpk_dev_minio_password
S3_FORCE_PATH_STYLE=true
S3_BUCKET_ASSETS=mtpk-assets
S3_BUCKET_PRIVATE=mtpk-private

# --- Порты сервисов (локально) ------------------------------------------------
WEB_PORT=3200
CONTENT_PORT=4101
LEADS_PORT=4102
SEARCH_PORT=4103
MEDIA_PORT=4104

# --- Адреса сервисов друг для друга ------------------------------------------
CONTENT_URL=http://127.0.0.1:4101
LEADS_URL=http://127.0.0.1:4102
SEARCH_URL=http://127.0.0.1:4103
MEDIA_URL=http://127.0.0.1:4104
WEB_URL=http://127.0.0.1:3200
# админка (сайт проксирует на неё адрес /admin)
ADMIN_URL=http://127.0.0.1:3300

# --- Служебные токены ----------------------------------------------------------
# Доступ к админ-API контента (админка, сброс кеша) и вебхуку ревалидации Next.
ADMIN_TOKEN=change-me-admin-token
# Секрет ссылки входа в админку: <сайт>/admin/login?token=<значение>. Без него страница
# входа отвечает 404. Длинная случайная строка (от 24 символов), не публиковать.
ADMIN_LOGIN_TOKEN=change-me-long-random-login-token
REVALIDATE_SECRET=change-me-revalidate-secret

# --- Заявки (замена send.php) -------------------------------------------------
# Хосты, с которых принимаются формы (проверка Origin/Referer).
LEADS_ALLOWED_HOSTS=uralinduktor.ru,new.uralinduktor.ru,localhost,127.0.0.1
# true — если перед сервисом стоит свой шлюз (gateway), который ставит X-Real-IP.
LEADS_TRUST_PROXY=false
# smtp — реальная отправка; log — письмо только в лог (локальная разработка).
MAIL_TRANSPORT=log
SMTP_HOST=
SMTP_PORT=465
# ssl (465) или tls (STARTTLS, 587)
SMTP_SECURE=ssl
SMTP_USER=
SMTP_PASS=
MAIL_TO=
MAIL_FROM=
# Входящий вебхук Битрикс24 (https://<портал>.bitrix24.ru/rest/<id>/<token>/). Пусто — не отправлять.
B24_WEBHOOK=
# Пользовательское поле лида для Client ID Метрики.
B24_YM_UID_FIELD=UF_CRM_YA_CID

