{
  "name": "@mtpk/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3200 --hostname 127.0.0.1",
    "dev:client": "tsx scripts/build-client.ts --watch",
    "build": "tsx scripts/build-client.ts && next build",
    "start": "next start --port 3200 --hostname 127.0.0.1",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p src/legacy/tsconfig.json --noEmit && tsc -p scripts/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@mtpk/content-kit": "*",
    "@mtpk/content-model": "*",
    "@mtpk/ui": "*",
    "next": "16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@mtpk/shared": "*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "*",
    "sharp": "^0.35.5"
  }
}
