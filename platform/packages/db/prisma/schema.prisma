// Схема базы данных платформы — единственное её описание. По ней Prisma
// строит миграции (prisma/migrations) и типизированный клиент
// (src/generated/prisma). Таблицы разложены по схемам PostgreSQL —
// у каждого сервиса своя: content, leads, mailing, search, admin.
//
//   npm run db:migrate                      — применить миграции
//   npm run db:migration -- --name <имя>    — новая миграция по изменениям схемы

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
  schemas  = ["admin", "content", "leads", "mailing", "search"]
}

// ─── content: страницы, стили, редиректы, склад, настройки, файлы ───────────

/// Страница сайта: содержимое — блоки (@mtpk/content-model).
model Page {
  id           Int       @id @default(autoincrement())
  path         String    @unique(map: "pages_path_unique")
  /// page — страница в общем каркасе сайта; document — готовый HTML-документ (Практикум)
  kind         String    @default("page")
  /// тип шаблона (T01…T15 по docs/page-types): home, section, category, product, spare…
  template     String    @default("page")
  title        String
  description  String?
  /// содержимое страницы: блоки (@mtpk/content-model); у документов — пусто
  blocks       Json      @default("[]")
  /// kind=document — готовый HTML-документ; у страниц — исходник, из которого получены блоки (архив)
  body         String?
  /// общие шаблонные CSS, порядок важен (каскад)
  cssTemplates String[]  @default([]) @map("css_templates")
  /// стили страницы (StyleBlock.hash) по порядку
  styleHashes  String[]  @default([]) @map("style_hashes")
  preloadImage String?   @map("preload_image")
  noindex      Boolean   @default(false)
  /// служебные отметки: source — откуда страница (import, admin, catalog), pagefindBody — у документов: что индексировать в поиске
  extraMeta    Json      @default("{}") @map("extra_meta")
  /// первая публикация — datePublished в JSON-LD
  publishedAt  DateTime? @map("published_at") @db.Timestamptz(6)
  /// последняя правка содержимого — dateModified в JSON-LD
  modifiedAt   DateTime? @map("modified_at") @db.Timestamptz(6)
  /// lastmod для sitemap
  lastmodAt    DateTime  @default(now()) @map("lastmod_at") @db.Timestamptz(6)
  /// хеш исходника: повторный импорт пропускает неизменённые страницы
  sourceHash   String    @map("source_hash")
  status       String    @default("published")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// страница принадлежит каталогу: это страница категории, подкатегории или товара
  category     Category?
  subcategory  Subcategory?
  product      Product?

  @@index([template], map: "pages_template_idx")
  @@index([kind], map: "pages_kind_idx")
  @@map("pages")
  @@schema("content")
}

// ─── content: каталог продукции — категория → подкатегория → товар ──────────
// Карточки в списках (главная, «Модельный ряд», товары подкатегории) строятся
// из этих таблиц. Содержимое страниц (обложка, тексты, фото, характеристики,
// SEO) — в связанной записи pages.

/// Категория (1-й уровень): «Индукционные плавильные печи». Карточка на главной и своя страница.
model Category {
  id            Int           @id @default(autoincrement())
  pageId        Int           @unique @map("page_id")
  page          Page          @relation(fields: [pageId], references: [id], onDelete: Cascade)
  /// название в карточке на главной
  name          String
  /// подпись в хлебных крошках
  crumb         String
  /// обложка карточки на главной
  cover         String?
  coverAlt      String        @default("") @map("cover_alt")
  /// атрибуты картинки обложки (ширина, высота…)
  coverAttrs    Json          @default("{}") @map("cover_attrs")
  /// порядок на главной и в каталоге
  sort          Int           @default(0)
  /// показывать карточку в сетке «Оборудование» на главной
  onHome        Boolean       @default(true) @map("on_home")
  /// скрыта на сайте (тумблер в админке «Каталог»): страница — 404, нет в карте сайта, списках, поиске и меню; вместе с подкатегориями и товарами
  hidden        Boolean       @default(false)
  /// equipment — оборудование; spares — запчасти; hub — витрина раздела (общая страница запчастей)
  kind          String        @default("equipment")
  /// секции под каждым товаром категории: формы, преимущества, партнёры (шаблон товара)
  productBlocks Json          @default("[]") @map("product_blocks")
  subcategories Subcategory[]
  products      Product[]
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("categories")
  @@schema("content")
}

/// Подкатегория (2-й уровень): «Дробемёт кранового типа». Карточка в «Модельном ряду» категории и своя страница.
model Subcategory {
  id          Int       @id @default(autoincrement())
  pageId      Int       @unique @map("page_id")
  page        Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  categoryId  Int       @map("category_id")
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  /// название в карточке
  name        String
  /// подпись в хлебных крошках
  crumb       String
  /// краткое описание в карточке
  description String    @default("")
  cover       String?
  coverAlt    String    @default("") @map("cover_alt")
  coverAttrs  Json      @default("{}") @map("cover_attrs")
  sort        Int       @default(0)
  /// показывать карточку в «Модельном ряду» категории
  listed      Boolean   @default(true)
  /// скрыта на сайте (тумблер в админке «Каталог»): страница — 404, нет в карте сайта, списках, поиске и меню; вместе с товарами
  hidden      Boolean   @default(false)
  products    Product[]
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([categoryId], map: "subcategories_category_idx")
  @@map("subcategories")
  @@schema("content")
}

/// Товар (3-й уровень): карточка в списке товаров и своя страница.
model Product {
  id            Int          @id @default(autoincrement())
  pageId        Int          @unique @map("page_id")
  page          Page         @relation(fields: [pageId], references: [id], onDelete: Cascade)
  categoryId    Int          @map("category_id")
  category      Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  /// подкатегория (у части товаров её нет — они прямо в категории)
  subcategoryId Int?         @map("subcategory_id")
  subcategory   Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: Restrict)
  /// название в карточке
  name          String
  /// примечание после названия в карточке: «(на гидравлике)»
  nameNote      String?      @map("name_note")
  cover         String?
  coverAlt      String       @default("") @map("cover_alt")
  coverAttrs    Json         @default("{}") @map("cover_attrs")
  /// плашка на обложке: «Кранового типа»
  badge         String?
  /// происхождение: «Производство Россия»
  origin        String?
  /// подпись под названием
  caption       String?
  /// раздел линейки над названием: «Воск · Модельный автомат»
  label         String?
  /// надпись ссылки в карточке, если не «Подробнее»: «Получить расчёт»
  linkText      String?      @map("link_text")
  /// срок гарантии в блоке «Преимущества» под товаром, если не 18 месяцев: «12 месяцев»
  warranty      String?
  /// характеристики в карточке: [{ label, value }]
  specs         Json         @default("[]")
  /// кнопки карточки
  actions       Json         @default("[]")
  /// атрибуты карточки для фильтра каталога (data-power…)
  attrs         Json         @default("{}")
  /// порядок в списке
  sort          Int          @default(0)
  /// показывать карточку в списке товаров подкатегории (категории)
  listed        Boolean      @default(true)
  /// скрыта на сайте (тумблер в админке «Каталог»): страница — 404, нет в карте сайта, списках, поиске и меню; данные товара сохраняются
  hidden        Boolean      @default(false)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([categoryId], map: "products_category_idx")
  @@index([subcategoryId], map: "products_subcategory_idx")
  @@map("products")
  @@schema("content")
}

/// CSS страниц (файлы /css/inline-extracted/inline-<hash>.css), общий для страниц с одинаковыми стилями.
model StyleBlock {
  hash      String   @id
  /// external — CSS как есть; inline — блок вместе с тегом <style> (мелкие блоки старого импорта)
  mode      String
  css       String
  bytes     Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("style_blocks")
  @@schema("content")
}

/// Скрипты блоков «Скрипт»: исходник (TypeScript/JavaScript) и собранный JS.
/// Сайт подключает файл по хешу исходника: /js/page/<хеш>.js.
model ScriptBlock {
  hash      String   @id
  source    String
  js        String
  bytes     Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("script_blocks")
  @@schema("content")
}

/// 301-редиректы (наследие WordPress и добавленные вручную).
model Redirect {
  id        Int      @id @default(autoincrement())
  fromPath  String   @unique(map: "redirects_from_path_unique") @map("from_path")
  toPath    String   @map("to_path")
  code      Int      @default(301)
  /// legacy-map — импорт из server/redirects-legacy.map; manual — добавлен вручную
  source    String   @default("manual")
  comment   String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("redirects")
  @@schema("content")
}

/// Позиция «Наличия на складе».
model StockItem {
  id        Int      @id @default(autoincrement())
  position  Int      @default(0)
  /// тип позиции (StockGroup.key): карточка типа на главной, фильтр на /nalichie/
  groupKey  String?  @map("group_key")
  /// страница товара или раздела каталога; пусто — позиция без ссылки
  url       String   @default("")
  qty       Int?
  shipping  String?
  /// цена, ₽ — на карточке /nalichie/; нет — «по запросу»
  price     Int?
  /// «от» перед ценой
  priceFrom Boolean  @default(false) @map("price_from")
  /// пояснение к цене в одну строку: «с НДС», «за комплект»
  priceNote String?  @map("price_note")
  note      String?
  title     String?
  image     String?
  /// характеристики: [название, значение][]
  specs     Json?
  /// фото со склада (подтверждение наличия): [{ src, alt }]
  photos    Json     @default("[]")
  /// скрыта на сайте: остаётся в админке, но не выводится ни в блоках склада, ни бейджем «В наличии»
  hidden    Boolean  @default(false)
  /// неизвестные поля исходного конфига — как есть
  extra     Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("stock_items")
  @@schema("content")
}

/// Тип позиций склада («Индукционные нагреватели и печи», «Запчасти для индукционного оборудования»):
/// карточка в блоке склада на главной и кнопка фильтра на /nalichie/.
model StockGroup {
  id        Int      @id @default(autoincrement())
  /// метка в адресе фильтра: /nalichie/?type=<key>
  key       String   @unique(map: "stock_groups_key_unique")
  /// equipment — оборудование, parts — запчасти и расходники
  kind      String   @default("equipment")
  title     String
  /// фото карточки на главной; нет — фото первой позиции
  image     String?
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("stock_groups")
  @@schema("content")
}

/// Настройки сайта (ключ → JSON): 'site' — контакты, реквизиты, меню, подвал (@mtpk/content-model).
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// кто изменил (e-mail пользователя админки)
  updatedBy String?  @map("updated_by")

  @@map("settings")
  @@schema("content")
}

/// Каталог объектов в S3-бакете ассетов (картинки, файлы, ассеты Практикума).
model Asset {
  key         String   @id
  size        Int
  etag        String
  contentType String   @map("content_type")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("assets")
  @@schema("content")
}

// ─── leads: заявки с сайта ──────────────────────────────────────────────────

/// Заявка с формы сайта (заменяет leads.log старого send.php).
model Lead {
  id              Int       @id @default(autoincrement())
  /// request_id формы: повторная отправка той же заявки не создаёт дубль
  requestId       String?   @unique(map: "leads_request_id_unique") @map("request_id")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// форма и страница: «Подбор и расчёт · /products/…»
  source          String?
  /// полный адрес страницы (из Referer, на боевом домене)
  pageUrl         String?   @map("page_url")
  phone           String
  name            String?
  email           String?
  task            String?
  /// прочие поля форм (запчасти и др.): message, part, model, quantity…
  fields          Json      @default("{}")
  /// utm_*, yclid, gclid, fbclid, referrer, landing_url
  utm             Json      @default("{}")
  consent         String?
  b24Trace        String?   @map("b24_trace")
  b24TraceValid   Boolean   @default(false) @map("b24_trace_valid")
  ymUid           String?   @map("ym_uid")
  roistatVisit    String?   @map("roistat_visit")
  ip              String?
  userAgent       String?   @map("user_agent")
  /// вложение «Прикрепить КП»: ключ в приватном бакете (удаляется после отправки письма)
  attachmentKey   String?   @map("attachment_key")
  attachmentName  String?   @map("attachment_name")
  attachmentNote  String?   @map("attachment_note")
  /// received → delivered | partial | failed
  status          String    @default("received")
  mailStatus      String    @default("pending") @map("mail_status")
  mailError       String?   @map("mail_error")
  mailSentAt      DateTime? @map("mail_sent_at") @db.Timestamptz(6)
  b24Status       String    @default("pending") @map("b24_status")
  b24LeadId       Int?      @map("b24_lead_id")
  b24Http         Int?      @map("b24_http")
  b24TraceStatus  String?   @map("b24_trace_status")
  b24TraceId      Int?      @map("b24_trace_id")
  b24Error        String?   @map("b24_error")
  deliveredAt     DateTime? @map("delivered_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([createdAt], map: "leads_created_idx")
  @@index([status], map: "leads_status_idx")
  @@map("leads")
  @@schema("leads")
}

/// Отброшенная попытка отправки (honeypot, слишком быстрое заполнение).
model LeadReject {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  reason    String
  phone     String?
  name      String?
  source    String?
  ip        String?
  userAgent String?  @map("user_agent")

  @@map("lead_rejects")
  @@schema("leads")
}

// ─── search: поисковый индекс сайта ─────────────────────────────────────────

/// Страница в поисковом индексе.
model SearchDocument {
  path      String                   @id
  title     String
  /// видимый текст страницы без разметки
  body      String
  image     String?
  /// вес в выдаче: разделы каталога — 10, остальное — 1
  weight    Int                      @default(1)
  /// русская морфология, заголовок весит больше текста. Столбец вычисляет
  /// PostgreSQL (GENERATED ALWAYS AS … STORED, миграция 0_init); Prisma видит
  /// это выражение как значение по умолчанию — оно должно совпадать с базой.
  tsv       Unsupported("tsvector")? @default(dbgenerated("(setweight(to_tsvector('russian'::regconfig, COALESCE(title, ''::text)), 'A'::\"char\") || setweight(to_tsvector('russian'::regconfig, COALESCE(body, ''::text)), 'C'::\"char\"))"))
  updatedAt DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tsv], map: "documents_tsv_idx", type: Gin)
  @@index([title(ops: raw("gin_trgm_ops"))], map: "documents_title_trgm_idx", type: Gin)
  @@map("documents")
  @@schema("search")
}

// ─── admin: пользователи админки и журнал действий ──────────────────────────

/// Пользователь админки. Роли: admin — всё; editor — контент; manager — заявки.
model User {
  id            Int       @id @default(autoincrement())
  email         String    @unique(map: "users_email_unique")
  name          String
  /// scrypt: 'scrypt$N$r$p$соль$хеш' (base64url)
  passwordHash  String    @map("password_hash")
  role          String    @default("editor")
  active        Boolean   @default(true)
  /// 2FA: секрет кодов из приложения (TOTP, Base32); null — 2FA выключена
  totpSecret    String?   @map("totp_secret")
  totpEnabledAt DateTime? @map("totp_enabled_at") @db.Timestamptz(6)
  /// 2FA: SHA-256 неиспользованных резервных кодов
  recoveryCodes String[]  @default([]) @map("recovery_codes")
  lastLoginAt   DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("users")
  @@schema("admin")
}

/// Журнал действий в админке: кто, когда и что изменил.
model AuditEntry {
  id        Int      @id @default(autoincrement())
  at        DateTime @default(now()) @db.Timestamptz(6)
  userId    Int?     @map("user_id")
  userEmail String?  @map("user_email")
  /// page.update, page.create, settings.update, redirect.delete, lead.resend, login…
  action    String
  /// адрес страницы, id записи, ключ файла
  target    String?
  details   Json?
  ip        String?

  @@index([at], map: "audit_at_idx")
  @@index([target], map: "audit_target_idx")
  @@map("audit_log")
  @@schema("admin")
}

// ─── mailing: e-mail рассылки — контакты, базы, рассылки, переходы ──────────

/// Контакт рассылок — один на адрес. Отписавшиеся и недоставляемые (bounced)
/// не получают писем ни из одной базы.
model MailContact {
  id             Int              @id @default(autoincrement())
  /// в нижнем регистре
  email          String           @unique(map: "mail_contacts_email_unique")
  name           String?
  company        String?
  phone          String?
  /// откуда пришёл первым: file | text | leads | crm | manual
  source         String           @default("manual")
  /// active | unsubscribed | bounced
  status         String           @default("active")
  unsubscribedAt DateTime?        @map("unsubscribed_at") @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  lists          MailListMember[]

  @@index([status], map: "mail_contacts_status_idx")
  @@map("contacts")
  @@schema("mailing")
}

/// База рассылки: набор контактов (из файла, заявок сайта, CRM, вручную).
model MailList {
  id          Int              @id @default(autoincrement())
  name        String
  description String?
  /// последнее пополнение из заявок: { kind: 'leads', from, to } — для «Обновить из заявок»
  source      Json             @default("{}")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  members     MailListMember[]
  campaigns   MailCampaign[]
  imports     MailImport[]

  @@map("lists")
  @@schema("mailing")
}

model MailListMember {
  listId    Int         @map("list_id")
  contactId Int         @map("contact_id")
  addedAt   DateTime    @default(now()) @map("added_at") @db.Timestamptz(6)
  list      MailList    @relation(fields: [listId], references: [id], onDelete: Cascade)
  contact   MailContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([listId, contactId])
  @@index([contactId], map: "mail_list_members_contact_idx")
  @@map("list_members")
  @@schema("mailing")
}

/// Рассылка: письмо (HTML), база, расписание. При запуске получатели и ссылки
/// с UTM-метками фиксируются (recipients, links), письмо — с подставленными
/// ссылками отслеживания (compiled).
model MailCampaign {
  id          Int             @id @default(autoincrement())
  name        String
  subject     String          @default("")
  /// текст-превью рядом с темой в почтовом ящике
  preheader   String          @default("")
  fromName    String          @default("УралИндуктор") @map("from_name")
  html        String          @default("")
  listId      Int?            @map("list_id")
  /// utm_campaign ссылок письма
  utmCampaign String          @default("") @map("utm_campaign")
  /// draft | scheduled | sending | paused | sent | cancelled
  status      String          @default("draft")
  /// smtp — письма уходят; log — тестовый режим (не отправлялись)
  transport   String?
  scheduledAt DateTime?       @map("scheduled_at") @db.Timestamptz(6)
  startedAt   DateTime?       @map("started_at") @db.Timestamptz(6)
  finishedAt  DateTime?       @map("finished_at") @db.Timestamptz(6)
  compiled    String?
  total       Int             @default(0)
  createdBy   String?         @map("created_by")
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  list        MailList?       @relation(fields: [listId], references: [id], onDelete: SetNull)
  recipients  MailRecipient[]
  links       MailLink[]

  @@index([status], map: "mail_campaigns_status_idx")
  @@map("campaigns")
  @@schema("mailing")
}

/// Получатель рассылки: адрес на момент запуска, свой токен для ссылок, открытия и отписки.
model MailRecipient {
  id          Int          @id @default(autoincrement())
  campaignId  Int          @map("campaign_id")
  contactId   Int?         @map("contact_id")
  email       String
  name        String?
  token       String       @unique(map: "mail_recipients_token_unique")
  /// queued | sending | sent | failed | skipped
  status      String       @default("queued")
  attempts    Int          @default(0)
  error       String?
  lockedAt    DateTime?    @map("locked_at") @db.Timestamptz(6)
  sentAt      DateTime?    @map("sent_at") @db.Timestamptz(6)
  openedAt    DateTime?    @map("opened_at") @db.Timestamptz(6)
  opens       Int          @default(0)
  clickedAt   DateTime?    @map("clicked_at") @db.Timestamptz(6)
  clicks      Int          @default(0)
  campaign    MailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  clickEvents MailClick[]

  @@unique([campaignId, email], map: "mail_recipients_campaign_email_unique")
  @@index([campaignId, status], map: "mail_recipients_campaign_status_idx")
  @@map("recipients")
  @@schema("mailing")
}

/// Ссылка письма: исходный адрес и адрес с UTM-метками, счётчики переходов.
model MailLink {
  id           Int          @id @default(autoincrement())
  campaignId   Int          @map("campaign_id")
  position     Int
  /// текст ссылки или кнопки
  label        String       @default("")
  url          String
  /// куда ведёт переход: адрес с UTM-метками
  target       String
  utmContent   String       @default("") @map("utm_content")
  clicks       Int          @default(0)
  uniqueClicks Int          @default(0) @map("unique_clicks")
  campaign     MailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  clickEvents  MailClick[]

  @@index([campaignId], map: "mail_links_campaign_idx")
  @@map("links")
  @@schema("mailing")
}

/// Переход по ссылке письма.
model MailClick {
  id          BigInt         @id @default(autoincrement())
  linkId      Int            @map("link_id")
  recipientId Int?           @map("recipient_id")
  at          DateTime       @default(now()) @db.Timestamptz(6)
  userAgent   String?        @map("user_agent")
  link        MailLink       @relation(fields: [linkId], references: [id], onDelete: Cascade)
  recipient   MailRecipient? @relation(fields: [recipientId], references: [id], onDelete: SetNull)

  @@index([linkId], map: "mail_clicks_link_idx")
  @@index([recipientId], map: "mail_clicks_recipient_idx")
  @@index([at], map: "mail_clicks_at_idx")
  @@map("clicks")
  @@schema("mailing")
}

/// Импорт в базу, который идёт в фоне (CRM): ход и итог.
model MailImport {
  id         Int       @id @default(autoincrement())
  listId     Int       @map("list_id")
  /// crm
  kind       String
  /// running | done | failed
  status     String    @default("running")
  processed  Int       @default(0)
  added      Int       @default(0)
  skipped    Int       @default(0)
  error      String?
  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(6)
  list       MailList  @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@map("imports")
  @@schema("mailing")
}
