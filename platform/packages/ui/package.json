{
  "name": "@mtpk/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "React-компоненты сайта (только серверный рендер): блоки страниц, каталог, формы. browser/* — общая логика клиентских модулей (метки рекламы, маска телефона, сравнение, «Запросить цену»).",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./rules": "./src/catalog/rules.ts",
    "./browser/*": "./src/browser/*.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@mtpk/content-model": "*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "@mtpk/content-kit": "*"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}
