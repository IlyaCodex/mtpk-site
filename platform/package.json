{
  "name": "mtpk-platform",
  "private": true,
  "type": "module",
  "description": "uralinduktor.ru на Next.js + микросервисы (content, media, leads, search)",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*",
    "tools/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "infra:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "infra:down": "docker compose -f docker-compose.dev.yml down",
    "infra:reset": "docker compose -f docker-compose.dev.yml down -v",
    "db:generate": "npm run generate -w @mtpk/db",
    "db:migrate": "npm run migrate -w @mtpk/db",
    "dev": "tsx scripts/dev.ts",
    "build:services": "tsx scripts/build-services.ts",
    "build:web": "npm run build -w @mtpk/web",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p scripts/tsconfig.json --noEmit",
    "test": "npm run test --workspaces --if-present",
    "checks": "npm run start -w @mtpk/checks --",
    "clean": "tsx scripts/clean.ts",
    "build:admin": "npm run build -w @mtpk/admin",
    "admin:user": "npm run create-user -w @mtpk/admin --",
    "media:warm": "tsx scripts/warm-images.ts",
    "db:migration": "npm run migration -w @mtpk/db --",
    "db:status": "npm run status -w @mtpk/db",
    "postinstall": "npm run generate -w @mtpk/db"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "~0.28.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
