{
  "name": "@mtpk/leads-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "dev:worker": "tsx watch --clear-screen=false src/worker.ts",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.2",
    "@mtpk/db": "*",
    "@mtpk/shared": "*",
    "bullmq": "^5.81.5",
    "fastify": "^5.12.5",
    "nodemailer": "^10.0.15"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2"
  }
}
